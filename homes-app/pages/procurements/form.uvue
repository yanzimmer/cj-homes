<template>
  <view class="page">
    <view class="card form-card">
      <text class="section-title">{{ isEdit ? "编辑采购" : "新增采购" }}</text>

      <view class="field-group">
        <text class="label">时间 *</text>
        <picker mode="date" :value="procurementDate" @change="onProcurementDateChange">
          <view class="picker-view">{{ procurementDate == "" ? "请选择时间" : procurementDate }}</view>
        </picker>
      </view>

      <view class="field-group">
        <text class="label">维修项目 *</text>
        <input v-model="itemName" class="input" placeholder="请输入维修项目" />
      </view>

      <view class="field-group">
        <text class="label">规格</text>
        <input v-model="specification" class="input" placeholder="请输入规格" />
      </view>

      <view class="field-group">
        <text class="label">数量 *</text>
        <input v-model="quantity" class="input" type="number" placeholder="例如 10" />
      </view>

      <view class="field-group">
        <text class="label">单价 *</text>
        <input v-model="unitPrice" class="input" type="number" placeholder="例如 10.50" />
      </view>

      <view class="field-group">
        <text class="label">单位 *</text>
        <input v-model="unit" class="input" placeholder="例如 个" />
      </view>

      <view class="field-group">
        <text class="label">总金额 *</text>
        <input v-model="totalAmount" class="input" type="number" placeholder="例如 100.00" />
      </view>

      <view class="field-group">
        <text class="label">备注</text>
        <textarea v-model="remarks" class="textarea" placeholder="可选" />
      </view>

      <view class="field-group">
        <text class="label">图片</text>
        <view class="row image-actions">
          <button class="small-btn action-btn" @click="pickProcurementImage">选择图片</button>
          <button class="small-btn danger-btn" :disabled="procurementImages.length == 0" @click="clearProcurementImages">清空</button>
        </view>
        <text class="muted">{{ procurementImages.length }} / 20</text>
        <text v-if="uploadingImage" class="muted">上传进度 {{ uploadProgress }}%</text>
        <view v-if="procurementImages.length > 0" class="image-list">
          <view v-for="(item, index) in procurementImages" :key="`${item}-${index}`" class="image-item">
            <image class="image-thumb" :src="normalizeImage(item)" mode="aspectFill" @click="openProcurementImage(index)" />
            <button class="tiny-btn danger-btn" @click="removeProcurementImage(index)">删除</button>
          </view>
        </view>
      </view>

      <button class="btn-primary" :disabled="loading" @click="submitForm">
        {{ loading ? "提交中..." : "保存" }}
      </button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from "vue"
import { onLoad } from "@dcloudio/uni-app"
import { apiCreateProcurement, apiUpdateProcurement, apiUploadProcurementImage } from "../../api/services.uts"
import { getErrorMessage, parseJsonText, toNumber } from "../../common/page.uts"
import { getApiHost } from "../../common/request.uts"

const id = ref(0)
const loading = ref(false)

const procurementDate = ref("")
const itemName = ref("")
const specification = ref("")
const quantity = ref("1")
const unitPrice = ref("0")
const unit = ref("")
const totalAmount = ref("0")
const remarks = ref("")
const procurementImages = ref<string[]>([])
const originalProcurementImages = ref<string[]>([])
const uploadingImage = ref(false)
const uploadProgress = ref(0)

const isEdit = computed(() => id.value > 0)

function onProcurementDateChange(e : any) {
  procurementDate.value = e != null && e.detail != null && e.detail.value != null ? String(e.detail.value) : ""
}

function normalizeImage(value : any) : string {
  if (value == null) return ""
  const text = String(value)
  if (text == "") return ""
  if (
    text.startsWith("data:")
    || text.startsWith("http://")
    || text.startsWith("https://")
    || text.startsWith("file://")
    || text.startsWith("content://")
    || text.startsWith("wxfile://")
    || text.startsWith("blob:")
    || text.startsWith("_doc/")
    || text.startsWith("_www/")
    || text.startsWith("\\")
    || text.includes(":\\")
  ) {
    return text
  }
  if (text.startsWith("/static/")) {
    return `${getApiHost()}${text}`
  }
  if (text.startsWith("/")) {
    return text
  }
  return `${getApiHost()}/${text}`
}

function extractProcurementImages(data : any) : string[] {
  if (data != null && Array.isArray(data.procurement_images)) {
    return data.procurement_images.map((v : any) => String(v)).filter((v : string) => v.trim() != "").slice(0, 20)
  }
  const raw = data != null && data.procurement_image != null ? String(data.procurement_image) : ""
  if (raw.trim() == "") return []
  if (raw.trim().startsWith("[")) {
    try {
      const arr = JSON.parse(raw)
      if (Array.isArray(arr)) {
        return arr.map((v : any) => String(v)).filter((v : string) => v.trim() != "").slice(0, 20)
      }
    } catch (e) {
    }
  }
  return [raw]
}

function fillForm(data : any) {
  id.value = data != null && data.id != null ? Number(data.id) : 0
  procurementDate.value = data != null && data.procurement_date != null ? String(data.procurement_date) : ""
  itemName.value = data != null && data.item_name != null ? String(data.item_name) : ""
  specification.value = data != null && data.specification != null ? String(data.specification) : ""
  quantity.value = data != null && data.quantity != null ? String(data.quantity) : "1"
  if (data != null && data.unit_price != null) {
    unitPrice.value = String(data.unit_price)
  } else {
    const qty = data != null && data.quantity != null ? toNumber(data.quantity, 0) : 0
    const total = data != null && data.total_amount != null ? toNumber(data.total_amount, 0) : 0
    unitPrice.value = qty > 0 ? String(total / qty) : "0"
  }
  unit.value = data != null && data.unit != null ? String(data.unit) : ""
  totalAmount.value = data != null && data.total_amount != null ? String(data.total_amount) : "0"
  remarks.value = data != null && data.remarks != null ? String(data.remarks) : ""
  procurementImages.value = extractProcurementImages(data)
  originalProcurementImages.value = procurementImages.value.slice(0)
  uploadingImage.value = false
  uploadProgress.value = 0
}

function pickProcurementImage() {
  const remain = 20 - procurementImages.value.length
  if (remain <= 0) {
    uni.showToast({ title: "最多仅支持20张", icon: "none" })
    return
  }
  uni.chooseImage({
    count: remain > 9 ? 9 : remain,
    sizeType: ["compressed"],
    sourceType: ["album", "camera"],
    success: (res : any) => {
      const paths = res.tempFilePaths != null ? res.tempFilePaths : []
      for (let i = 0; i < paths.length; i++) {
        const path = String(paths[i])
        if (path == "") continue
        if (procurementImages.value.length >= 20) break
        procurementImages.value.push(path)
      }
    },
  })
}

function openProcurementImage(index : number) {
  if (index < 0 || index >= procurementImages.value.length) return
  const urls = procurementImages.value.map((item : string) => normalizeImage(item))
  uni.previewImage({ urls, current: urls[index] })
}

function removeProcurementImage(index : number) {
  if (index < 0 || index >= procurementImages.value.length) return
  procurementImages.value.splice(index, 1)
}

function clearProcurementImages() {
  procurementImages.value = []
}

async function syncProcurementImages(targetId : number) {
  if (targetId <= 0) return
  const originalSet = new Set(originalProcurementImages.value)
  const keepServerImages = procurementImages.value.filter((item : string) => originalSet.has(item))
  const localImages = procurementImages.value.filter((item : string) => !originalSet.has(item))
  await apiUpdateProcurement(targetId, { procurement_images: keepServerImages })
  if (localImages.length == 0) {
    uploadProgress.value = 100
    return
  }
  uploadingImage.value = true
  uploadProgress.value = 0
  for (let i = 0; i < localImages.length; i++) {
    const localPath = localImages[i]
    await apiUploadProcurementImage(targetId, localPath, (res : any) => {
      const current = res != null && res.progress != null ? Number(res.progress) : 0
      const finished = i + (current / 100)
      const total = localImages.length
      uploadProgress.value = Math.floor((finished / total) * 100)
    })
  }
  uploadProgress.value = 100
  uploadingImage.value = false
}

function validate(payload : any) : boolean {
  if (payload.procurement_date == "") {
    uni.showToast({ title: "请选择时间", icon: "none" })
    return false
  }
  if (payload.item_name == "") {
    uni.showToast({ title: "请输入维修项目", icon: "none" })
    return false
  }
  if (payload.quantity <= 0) {
    uni.showToast({ title: "请输入正确数量", icon: "none" })
    return false
  }
  if (payload.unit_price < 0) {
    uni.showToast({ title: "请输入正确单价", icon: "none" })
    return false
  }
  if (payload.unit == "") {
    uni.showToast({ title: "请输入单位", icon: "none" })
    return false
  }
  if (payload.total_amount < 0) {
    uni.showToast({ title: "请输入正确金额", icon: "none" })
    return false
  }
  return true
}

async function submitForm() {
  if (loading.value) {
    return
  }

  const payload = {
    procurement_date: procurementDate.value.trim(),
    item_name: itemName.value.trim(),
    specification: specification.value.trim(),
    quantity: toNumber(quantity.value, 0),
    unit_price: toNumber(unitPrice.value, 0),
    unit: unit.value.trim(),
    total_amount: toNumber(totalAmount.value, 0),
    remarks: remarks.value.trim(),
    procurement_images: originalProcurementImages.value.slice(0, 20),
  }

  if (!validate(payload)) {
    return
  }

  loading.value = true
  try {
    let targetId = id.value
    if (isEdit.value) {
      await apiUpdateProcurement(id.value, payload)
    } else {
      const created = await apiCreateProcurement(payload)
      const newId = Number(created != null ? created.id : 0)
      if (!isNaN(newId) && newId > 0) {
        targetId = newId
      }
    }
    await syncProcurementImages(targetId)
    uni.showToast({ title: "保存成功", icon: "success" })
    setTimeout(() => {
      uni.navigateBack()
    }, 300)
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "保存失败"), icon: "none" })
  } finally {
    loading.value = false
  }
}

onLoad((options : any) => {
  if (options != null && options.payload != null) {
    try {
      const raw = decodeURIComponent(String(options.payload))
      fillForm(parseJsonText(raw))
    } catch (e) {
      uni.showToast({ title: "编辑参数解析失败", icon: "none" })
    }
  }
})
</script>

<style>
.form-card {
  gap: 10px;
}

.field-group {
  gap: 6px;
}

.image-actions {
  gap: 8px;
}

.image-list {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.image-item {
  width: 96px;
  gap: 4px;
}

.label {
  font-size: 13px;
  color: #374151;
}

.input {
  height: 42px;
  border-width: 1px;
  border-style: solid;
  border-color: #d1d5db;
  border-radius: 10px;
  padding: 0 12px;
  background-color: #ffffff;
}

.picker-view {
  height: 42px;
  width: 100%;
  box-sizing: border-box;
  border-width: 1px;
  border-style: solid;
  border-color: #d1d5db;
  border-radius: 10px;
  padding: 0 12px;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #111827;
}

.textarea {
  min-height: 88px;
  border-width: 1px;
  border-style: solid;
  border-color: #d1d5db;
  border-radius: 10px;
  padding: 10px 12px;
  background-color: #ffffff;
}

.image-thumb {
  width: 96px;
  height: 96px;
  border-radius: 10px;
  background: #f3f4f6;
}
</style>
