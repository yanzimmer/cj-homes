<template>
  <view class="page">
    <view class="card hero-card">
      <view class="row space-between top-line">
        <view>
          <text class="section-title">库房管理</text>
          <text class="hero-sub">支持物品查询、详情、编辑、删除与图片预览</text>
        </view>
        <view class="count-chip">{{ countText }}</view>
      </view>

      <view class="row search-row">
        <input v-model="keyword" class="input search-input" placeholder="名称 / 分类 / 位置 / 备注" />
      </view>

      <view class="row action-row">
        <button class="btn-strong" @click="openCreate">新增物品</button>
        <button class="btn-outline" :disabled="loading" @click="fetchItems">
          {{ loading ? "加载中..." : "刷新列表" }}
        </button>
      </view>
    </view>

    <view v-if="items.length == 0" class="card empty-card">
      <text class="muted">暂无物品数据</text>
    </view>

    <view v-for="item in items" :key="item.id" class="card item-card">
      <view class="row space-between item-head">
        <text class="item-title">{{ item.item_name || "-" }}</text>
        <text class="stock-chip">库存 {{ item.quantity || 0 }}{{ item.unit || "" }}</text>
      </view>

      <view class="item-body">
        <text class="line">分类：{{ item.category || "-" }}</text>
        <text class="line">位置：{{ item.location || "-" }}</text>
        <text class="line">备注：{{ item.remarks || "-" }}</text>
        <view v-if="extractImages(item).length > 0" class="detail-image-box">
          <image :src="toImageUrl(extractImages(item)[0])" class="detail-image" mode="aspectFill" @click="previewImages(extractImages(item), 0)" />
        </view>
      </view>

      <view class="row button-row">
        <button class="small-btn btn-outline" @click="openDetail(item)">详情</button>
        <button class="small-btn edit-btn" @click="openEdit(item)">编辑</button>
        <button class="small-btn danger-btn" @click="removeItem(item)">删除</button>
      </view>
    </view>

    <view v-if="detailVisible" class="detail-mask" @click="closeDetail">
      <scroll-view class="detail-sheet" scroll-y="true">
        <view class="card detail-card" @click.stop>
          <view class="row space-between">
            <text class="section-title">物品详情</text>
            <button class="btn-outline" @click="closeDetail">关闭</button>
          </view>

          <view v-if="detailLoading" class="detail-empty">
            <text class="muted">加载中...</text>
          </view>

          <view v-else class="detail-body">
            <text class="line">名称：{{ detailItem.item_name || "-" }}</text>
            <text class="line">分类：{{ detailItem.category || "-" }}</text>
            <text class="line">数量：{{ detailItem.quantity || 0 }}{{ detailItem.unit || "" }}</text>
            <text class="line">位置：{{ detailItem.location || "-" }}</text>
            <text class="line">备注：{{ detailItem.remarks || "-" }}</text>
            <text class="line">更新时间：{{ detailItem.updated_at || detailItem.created_at || "-" }}</text>

            <view v-if="detailImages.length > 0" class="detail-image-box">
              <image :src="toImageUrl(detailImages[0])" class="detail-image" mode="aspectFit" @click="previewImages(detailImages, 0)" />
            </view>
            <view v-else class="detail-empty">
              <text class="muted">暂无图片</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from "vue"
import { onShow } from "@dcloudio/uni-app"
import { apiDeleteWarehouseItem, apiGetWarehouseItemDetail, apiGetWarehouseItems } from "../../api/services.uts"
import { getApiHost } from "../../common/request.uts"
import { getErrorMessage, normalizeArray } from "../../common/page.uts"

const items = ref<any[]>([])
const totalCount = ref(0)
const filteredCount = ref(0)
const loading = ref(false)
const keyword = ref("")

const detailVisible = ref(false)
const detailLoading = ref(false)
const detailItem = ref<any>({})

const detailImages = computed(() => extractImages(detailItem.value))
const countText = computed(() => `共 ${items.value.length} 条`)

function toImageUrl(value : any) : string {
  const raw = value != null ? String(value) : ""
  if (raw == "") return ""
  if (raw.startsWith("data:") || raw.startsWith("http://") || raw.startsWith("https://")) return raw
  if (raw.startsWith("/")) return `${getApiHost()}${raw}`
  return `${getApiHost()}/${raw}`
}

function extractImages(item : any) : string[] {
  if (item != null && Array.isArray(item.images)) {
    return item.images.map((v : any) => String(v)).filter((v : string) => v.trim() != "")
  }
  const raw = item != null && item.image != null ? String(item.image) : ""
  if (raw.trim() == "") return []
  if (raw.trim().startsWith("[")) {
    try {
      const arr = JSON.parse(raw)
      if (Array.isArray(arr)) {
        return arr.map((v : any) => String(v)).filter((v : string) => v.trim() != "")
      }
    } catch (e) {
    }
  }
  return [raw]
}

function previewImages(values : string[], index : number = 0) {
  if (values.length == 0) return
  const urls = values.map((v : string) => toImageUrl(v)).filter((v : string) => v != "")
  if (urls.length == 0) return
  const current = index >= 0 && index < urls.length ? urls[index] : urls[0]
  uni.previewImage({ urls, current })
}

async function fetchItems() {
  if (loading.value) {
    return
  }

  loading.value = true
  try {
    const data = await apiGetWarehouseItems(keyword.value.trim())
    items.value = normalizeArray(data, ["warehouse_items", "items", "list"])
    const total = Number(data != null && data.total != null ? data.total : items.value.length)
    const filtered = Number(data != null && data.filtered_total != null ? data.filtered_total : items.value.length)
    totalCount.value = isNaN(total) ? items.value.length : total
    filteredCount.value = isNaN(filtered) ? items.value.length : filtered
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "获取物品失败"), icon: "none" })
  } finally {
    loading.value = false
  }
}

function openCreate() {
  uni.navigateTo({ url: "/pages/warehouse/form" })
}

function openEdit(item : any) {
  uni.navigateTo({ url: `/pages/warehouse/form?id=${item.id}` })
}

async function openDetail(item : any) {
  const id = Number(item.id)
  if (isNaN(id) || id <= 0) {
    uni.showToast({ title: "物品ID无效", icon: "none" })
    return
  }

  detailVisible.value = true
  detailLoading.value = true
  detailItem.value = item

  try {
    const data = await apiGetWarehouseItemDetail(id)
    detailItem.value = data != null ? data : item
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "获取详情失败"), icon: "none" })
  } finally {
    detailLoading.value = false
  }
}

function closeDetail() {
  detailVisible.value = false
}

function removeItem(item : any) {
  const id = Number(item.id)
  if (isNaN(id) || id <= 0) {
    uni.showToast({ title: "物品ID无效", icon: "none" })
    return
  }

  uni.showModal({
    title: "确认删除",
    content: `确定删除物品 #${id} 吗？`,
    success: async (res) => {
      if (!res.confirm) {
        return
      }
      try {
        await apiDeleteWarehouseItem(id)
        uni.showToast({ title: "删除成功", icon: "success" })
        fetchItems()
      } catch (err) {
        uni.showToast({ title: getErrorMessage(err, "删除失败"), icon: "none" })
      }
    },
  })
}

onShow(() => {
  fetchItems()
})
</script>

<style>
.hero-card,
.empty-card,
.item-card {
  margin-bottom: 12px;
}

.hero-card {
  border: 1px solid rgba(11, 96, 126, 0.2);
  background:
    linear-gradient(148deg, rgba(255, 255, 255, 0.95) 0%, rgba(226, 244, 252, 0.86) 56%, rgba(255, 244, 228, 0.86) 100%);
  box-shadow: 0 16px 28px rgba(16, 44, 68, 0.14);
}

.top-line {
  align-items: flex-start;
  gap: 8px;
  flex-wrap: wrap;
}

.top-line > view:first-child {
  flex: 1;
  min-width: 0;
}

.hero-sub {
  display: block;
  margin-top: 4px;
  color: #5b6f82;
  font-size: 12px;
  line-height: 16px;
  word-break: break-all;
}

.count-chip {
  min-width: 120px;
  max-width: 100%;
  min-height: 30px;
  padding: 0 10px;
  border-radius: 999px;
  background: linear-gradient(135deg, #0b6885 0%, #1490b3 100%);
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  text-align: center;
  line-height: 16px;
  white-space: nowrap;
}

.search-row {
  margin-top: 12px;
  gap: 8px;
}

.search-input {
  flex: 1;
  height: 40px;
  padding: 0 12px;
}

.action-row {
  margin-top: 10px;
  gap: 8px;
}

.action-row .btn-strong {
  flex: 1.1;
}

.action-row .btn-outline {
  flex: 0.9;
}

.item-card {
  border: 1px solid rgba(18, 43, 65, 0.12);
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 12px 22px rgba(18, 43, 65, 0.1);
}

.item-head {
  margin-bottom: 8px;
}

.item-title {
  font-size: 17px;
  font-weight: 800;
  color: #11293d;
}

.stock-chip {
  height: 26px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(17, 138, 77, 0.14);
  color: #166534;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.item-body {
  padding: 10px;
  border-radius: 12px;
  border: 1px solid rgba(18, 43, 65, 0.08);
  background: rgba(247, 252, 255, 0.92);
}

.line {
  display: block;
  margin-top: 4px;
  color: #2d4458;
  font-size: 13px;
}

.line:first-child {
  margin-top: 0;
}

.button-row {
  gap: 8px;
  margin-top: 10px;
}

.small-btn {
  flex: 1;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(13, 28, 43, 0.4);
  z-index: 1000;
  padding: 20px 16px;
  box-sizing: border-box;
}

.detail-sheet {
  height: 90vh;
  max-height: 90vh;
}

.detail-card {
  margin-top: 0;
  border: 1px solid rgba(18, 43, 65, 0.12);
}

.detail-body {
  margin-top: 6px;
  padding: 10px;
  border-radius: 12px;
  border: 1px solid rgba(18, 43, 65, 0.08);
  background: rgba(247, 252, 255, 0.92);
}

.detail-image-box {
  margin-top: 10px;
  border-radius: 12px;
  overflow: hidden;
  background: #f5fbff;
  border: 1px solid rgba(18, 43, 65, 0.1);
}

.detail-image {
  width: 100%;
  height: 180px;
}

.detail-empty {
  margin-top: 8px;
}

</style>
