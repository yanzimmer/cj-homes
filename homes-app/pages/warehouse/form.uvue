<template>
  <view class="page">
    <view class="card form-card">
      <text class="section-title">{{ isEdit ? "编辑物品" : "新增物品" }}</text>

      <view class="field-group">
        <text class="label">物品名称 *</text>
        <input v-model="itemName" class="input" placeholder="例如 LED灯泡" />
      </view>

      <view class="field-group">
        <text class="label">分类 *</text>
        <input v-model="category" class="input" placeholder="例如 照明" />
      </view>

      <view class="field-group">
        <text class="label">数量 *</text>
        <input v-model="quantity" class="input" type="number" placeholder="例如 56" />
      </view>

      <view class="field-group">
        <text class="label">单位 *</text>
        <input v-model="unit" class="input" placeholder="例如 个" />
      </view>

      <view class="field-group">
        <text class="label">存放位置</text>
        <input v-model="location" class="input" placeholder="例如 A库-货架1层" />
      </view>

      <view class="field-group">
        <text class="label">图片</text>
        <view class="row image-actions">
          <button class="small-btn action-btn" @click="pickImage">选择图片</button>
          <button class="small-btn danger-btn" :disabled="images.length == 0" @click="clearImage">清除</button>
        </view>
        <text class="muted">{{ images.length }} / 20</text>
        <view v-if="images.length > 0" class="image-list">
          <view v-for="(img, index) in images" :key="`${img}-${index}`" class="image-item">
            <image class="image-thumb-grid" :src="normalizeImage(img)" mode="aspectFill" @click="previewImage(index)" />
            <button class="tiny-btn danger-btn" @click="removeImage(index)">删除</button>
          </view>
        </view>
      </view>

      <view class="field-group">
        <text class="label">备注</text>
        <textarea v-model="remarks" class="textarea" placeholder="可选" />
      </view>

      <button class="btn-primary" :disabled="loading" @click="submitForm">
        {{ loading ? "提交中..." : "保存" }}
      </button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from "vue"
import { onLoad } from "@dcloudio/uni-app"
import { apiCreateWarehouseItem, apiGetWarehouseItemDetail, apiUpdateWarehouseItem } from "../../api/services.uts"
import { getApiHost } from "../../common/request.uts"
import { getErrorMessage, toNumber } from "../../common/page.uts"

const itemId = ref(0)
const loading = ref(false)

const itemName = ref("")
const category = ref("")
const quantity = ref("0")
const unit = ref("")
const location = ref("")
const images = ref<string[]>([])
const clearImageFlag = ref(false)
const remarks = ref("")

const isEdit = computed(() => itemId.value > 0)

function normalizeImage(value : any) : string {
  if (value == null) {
    return ""
  }
  const text = String(value)
  if (text == "") {
    return ""
  }
  if (
    text.startsWith("data:")
    || text.startsWith("http://")
    || text.startsWith("https://")
    || text.startsWith("file://")
    || text.startsWith("content://")
    || text.startsWith("wxfile://")
    || text.startsWith("blob:")
    || text.startsWith("_doc/")
    || text.startsWith("_www/")
    || text.startsWith("\\")
    || text.includes(":\\")
  ) {
    return text
  }
  if (text.startsWith("/static/")) {
    return `${getApiHost()}${text}`
  }
  if (text.startsWith("/")) {
    return text
  }
  return `${getApiHost()}/${text}`
}

function extractImages(data : any) : string[] {
  if (data != null && Array.isArray(data.images)) {
    return data.images.map((v : any) => String(v)).filter((v : string) => v.trim() != "").slice(0, 20)
  }
  const raw = data != null && data.image != null ? String(data.image) : ""
  if (raw.trim() == "") return []
  if (raw.trim().startsWith("[")) {
    try {
      const arr = JSON.parse(raw)
      if (Array.isArray(arr)) {
        return arr.map((v : any) => String(v)).filter((v : string) => v.trim() != "").slice(0, 20)
      }
    } catch (e) {
    }
  }
  return [raw]
}

function fillForm(data : any) {
  itemName.value = data != null && data.item_name != null ? String(data.item_name) : ""
  category.value = data != null && data.category != null ? String(data.category) : ""
  quantity.value = data != null && data.quantity != null ? String(data.quantity) : "0"
  unit.value = data != null && data.unit != null ? String(data.unit) : ""
  location.value = data != null && data.location != null ? String(data.location) : ""
  images.value = extractImages(data)
  remarks.value = data != null && data.remarks != null ? String(data.remarks) : ""
}

async function loadDetail() {
  if (itemId.value <= 0) {
    return
  }
  try {
    const data = await apiGetWarehouseItemDetail(itemId.value)
    fillForm(data)
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "加载详情失败"), icon: "none" })
  }
}

function validate(payload : any) : boolean {
  if (payload.item_name == "") {
    uni.showToast({ title: "请输入物品名称", icon: "none" })
    return false
  }
  if (payload.category == "") {
    uni.showToast({ title: "请输入分类", icon: "none" })
    return false
  }
  if (payload.quantity < 0) {
    uni.showToast({ title: "数量不能小于0", icon: "none" })
    return false
  }
  if (payload.unit == "") {
    uni.showToast({ title: "请输入单位", icon: "none" })
    return false
  }
  return true
}

function pickImage() {
  const remain = 20 - images.value.length
  if (remain <= 0) {
    uni.showToast({ title: "最多仅支持20张", icon: "none" })
    return
  }
  uni.chooseImage({
    count: remain > 9 ? 9 : remain,
    sizeType: ["compressed"],
    sourceType: ["album", "camera"],
    success: (res : any) => {
      const pathSet = new Set<string>()
      if (res != null && res.tempFilePaths != null) {
        const a = res.tempFilePaths
        for (let i = 0; i < a.length; i++) {
          const p = String(a[i] || "")
          if (p != "") pathSet.add(p)
        }
      }
      if (res != null && res.tempFiles != null) {
        const b = res.tempFiles
        for (let i = 0; i < b.length; i++) {
          const item = b[i]
          const p = item != null && item.path != null ? String(item.path) : ""
          if (p != "") pathSet.add(p)
        }
      }
      const paths = Array.from(pathSet)
      clearImageFlag.value = false
      for (let i = 0; i < paths.length; i++) {
        const path = String(paths[i])
        if (path == "") continue
        if (images.value.length >= 20) break
        if (images.value.includes(path)) continue
        images.value.push(path)
      }
      if (images.value.length == 0) {
        uni.showToast({ title: "未获取到可预览图片路径", icon: "none" })
      }
    },
    fail: () => {
      uni.showToast({ title: "选择图片失败", icon: "none" })
    },
  })
}

function previewImage(index : number) {
  if (index < 0 || index >= images.value.length) return
  const urls = images.value.map((v : string) => normalizeImage(v)).filter((v : string) => v != "")
  if (urls.length == 0) {
    uni.showToast({ title: "暂无可预览图片", icon: "none" })
    return
  }
  uni.previewImage({ urls, current: urls[index] })
}

function removeImage(index : number) {
  if (index < 0 || index >= images.value.length) return
  images.value.splice(index, 1)
}

function clearImage() {
  images.value = []
  clearImageFlag.value = true
}

function toDataUrl(path : string) : Promise<string> {
  return new Promise((resolve) => {
    try {
      const fs = uni.getFileSystemManager()
      fs.readFile({
        filePath: path,
        encoding: "base64",
        success: (res : any) => {
          const base64 = res.data != null ? String(res.data) : ""
          if (base64 == "") {
            resolve("")
            return
          }
          const ext = path.split(".").pop() || "png"
          const lower = String(ext).toLowerCase()
          const mime = lower == "jpg" || lower == "jpeg" ? "image/jpeg" : (lower == "webp" ? "image/webp" : "image/png")
          resolve(`data:${mime};base64,${base64}`)
        },
        fail: () => resolve(""),
      })
    } catch (err) {
      resolve("")
    }
  })
}

async function buildPayload() : Promise<any> {
  const payload : any = {
    item_name: itemName.value.trim(),
    category: category.value.trim(),
    quantity: toNumber(quantity.value, 0),
    unit: unit.value.trim(),
    location: location.value.trim(),
    remarks: remarks.value.trim(),
  }

  if (images.value.length > 0) {
    const prepared : string[] = []
    const source = images.value.slice(0, 20)
    for (let i = 0; i < source.length; i++) {
      const current = String(source[i] || "").trim()
      if (current == "") continue
      if (
        current.startsWith("data:")
        || current.startsWith("http://")
        || current.startsWith("https://")
        || current.startsWith("/static/")
      ) {
        prepared.push(current)
        continue
      }
      const converted = await toDataUrl(current)
      prepared.push(converted != "" ? converted : current)
    }
    payload.images = prepared
  } else if (clearImageFlag.value) {
    payload.images = []
  } else if (!isEdit.value) {
    payload.images = []
  }

  return payload
}

async function submitForm() {
  if (loading.value) {
    return
  }

  const payload = await buildPayload()

  if (!validate(payload)) {
    return
  }

  loading.value = true
  try {
    if (isEdit.value) {
      await apiUpdateWarehouseItem(itemId.value, payload)
    } else {
      await apiCreateWarehouseItem(payload)
    }
    uni.showToast({ title: "保存成功", icon: "success" })
    setTimeout(() => {
      uni.navigateBack()
    }, 300)
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "保存失败"), icon: "none" })
  } finally {
    loading.value = false
  }
}

onLoad((options : any) => {
  if (options != null && options.id != null) {
    itemId.value = Number(options.id)
    loadDetail()
  }
})
</script>

<style>
.form-card {
  gap: 10px;
}

.field-group {
  gap: 6px;
}

.image-actions {
  gap: 8px;
}

.image-list {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.image-item {
  width: 96px;
  gap: 4px;
}

.input {
  height: 42px;
  padding: 0 12px;
}

.textarea {
  min-height: 88px;
  padding: 10px 12px;
}

.image-thumb-grid {
  width: 96px;
  height: 96px;
  border-radius: 10px;
  background: #f3f4f6;
}
</style>
