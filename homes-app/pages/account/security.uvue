<template>
  <view class="page">
    <view class="back-wrap">
      <button class="btn-outline back-btn" @click="goBack">{{ "< " + backLabel }}</button>
    </view>
    <view class="card section">
      <text class="section-title">账号信息</text>
      <text class="muted">用户名：{{ usernameText }}</text>
      <text class="muted">姓名：{{ fullNameText }}</text>
      <text class="muted">Token过期：{{ tokenExpiresText }}</text>
    </view>

    <view class="card section">
      <text class="section-title">修改密码</text>
      <view class="field-group">
        <text class="label">旧密码</text>
        <input v-model="oldPassword" class="input" placeholder="请输入旧密码" password type="text" />
      </view>
      <view class="field-group">
        <text class="label">新密码</text>
        <input v-model="newPassword" class="input" placeholder="请输入新密码" password type="text" />
      </view>
      <view class="field-group">
        <text class="label">确认新密码</text>
        <input v-model="confirmPassword" class="input" placeholder="再次输入新密码" password type="text" />
      </view>
      <button class="btn-primary" :disabled="changeLoading" @click="changePassword">
        {{ changeLoading ? "提交中..." : "修改密码" }}
      </button>
    </view>

    <view class="card section">
      <text class="section-title">忘记密码</text>
      <text class="muted">无需登录，提供用户名与密保答案</text>
      <view class="field-group">
        <text class="label">用户名</text>
        <input v-model="forgotUsername" class="input" placeholder="例如 admin" />
      </view>
      <view class="field-group">
        <text class="label">密保答案</text>
        <input v-model="forgotAnswer" class="input" placeholder="请输入密保答案" />
      </view>
      <view class="field-group">
        <text class="label">新密码</text>
        <input v-model="forgotNewPassword" class="input" placeholder="请输入新密码" password type="text" />
      </view>
      <view class="field-group">
        <text class="label">确认新密码</text>
        <input v-model="forgotConfirmPassword" class="input" placeholder="再次输入新密码" password type="text" />
      </view>
      <button class="action-btn" :disabled="forgotLoading" @click="resetPassword">
        {{ forgotLoading ? "提交中..." : "重置密码" }}
      </button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from "vue"
import { onShow } from "@dcloudio/uni-app"
import { apiChangePassword, apiForgotPassword } from "../../api/services.uts"
import { getErrorMessage } from "../../common/page.uts"
import { getFullName, getTokenExpires, getUsername } from "../../common/session.uts"

const backLabel = "\u8fd4\u56de"

const username = ref("")
const fullName = ref("")
const tokenExpires = ref("")

const oldPassword = ref("")
const newPassword = ref("")
const confirmPassword = ref("")
const changeLoading = ref(false)

const forgotUsername = ref("")
const forgotAnswer = ref("")
const forgotNewPassword = ref("")
const forgotConfirmPassword = ref("")
const forgotLoading = ref(false)

const usernameText = computed(() => (username.value == "" ? "未登录" : username.value))
const fullNameText = computed(() => (fullName.value == "" ? "-" : fullName.value))
const tokenExpiresText = computed(() => (tokenExpires.value == "" ? "未知" : tokenExpires.value))

function loadUserInfo() {
  username.value = getUsername()
  fullName.value = getFullName()
  tokenExpires.value = getTokenExpires()
}

function validateChange() : boolean {
  if (oldPassword.value.trim() == "") {
    uni.showToast({ title: "请输入旧密码", icon: "none" })
    return false
  }
  if (newPassword.value.trim() == "") {
    uni.showToast({ title: "请输入新密码", icon: "none" })
    return false
  }
  if (newPassword.value.trim() != confirmPassword.value.trim()) {
    uni.showToast({ title: "两次新密码不一致", icon: "none" })
    return false
  }
  return true
}

async function changePassword() {
  if (changeLoading.value) {
    return
  }
  if (!validateChange()) {
    return
  }

  changeLoading.value = true
  try {
    await apiChangePassword(oldPassword.value.trim(), newPassword.value.trim())
    uni.showToast({ title: "修改成功", icon: "success" })
    oldPassword.value = ""
    newPassword.value = ""
    confirmPassword.value = ""
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "修改失败"), icon: "none" })
  } finally {
    changeLoading.value = false
  }
}

function validateForgot() : boolean {
  if (forgotUsername.value.trim() == "") {
    uni.showToast({ title: "请输入用户名", icon: "none" })
    return false
  }
  if (forgotAnswer.value.trim() == "") {
    uni.showToast({ title: "请输入密保答案", icon: "none" })
    return false
  }
  if (forgotNewPassword.value.trim() == "") {
    uni.showToast({ title: "请输入新密码", icon: "none" })
    return false
  }
  if (forgotNewPassword.value.trim() != forgotConfirmPassword.value.trim()) {
    uni.showToast({ title: "两次新密码不一致", icon: "none" })
    return false
  }
  return true
}

async function resetPassword() {
  if (forgotLoading.value) {
    return
  }
  if (!validateForgot()) {
    return
  }

  forgotLoading.value = true
  try {
    await apiForgotPassword(
      forgotUsername.value.trim(),
      forgotAnswer.value.trim(),
      forgotNewPassword.value.trim(),
    )
    uni.showToast({ title: "重置成功", icon: "success" })
    forgotAnswer.value = ""
    forgotNewPassword.value = ""
    forgotConfirmPassword.value = ""
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "重置失败"), icon: "none" })
  } finally {
    forgotLoading.value = false
  }
}

function goBack() {
  const pages = getCurrentPages()
  if (pages != null && pages.length > 1) {
    uni.navigateBack({ delta: 1 })
    return
  }
  uni.reLaunch({ url: "/pages/home/index" })
}

onShow(() => {
  loadUserInfo()
})
</script>

<style>
.section {
  margin-bottom: 12px;
  border: 1px solid rgba(18, 43, 65, 0.12);
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 12px 22px rgba(18, 43, 65, 0.1);
}

.section:first-child {
  border: 1px solid rgba(11, 96, 126, 0.2);
  background:
    linear-gradient(148deg, rgba(255, 255, 255, 0.95) 0%, rgba(226, 244, 252, 0.86) 56%, rgba(255, 244, 228, 0.86) 100%);
  box-shadow: 0 16px 28px rgba(16, 44, 68, 0.14);
}

.field-group {
  gap: 6px;
  margin-top: 8px;
}

.label {
  font-size: 13px;
  color: #1f3347;
  font-weight: 600;
}

.input {
  height: 40px;
  padding: 0 12px;
  font-size: 14px;
  border-radius: 12px;
}

.action-btn {
  margin-top: 10px;
}

.back-wrap {
  margin-bottom: 10px;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.back-btn {
  flex: 0 0 auto;
  width: auto !important;
  min-width: 88px;
  height: 34px;
  padding: 0 14px !important;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}


</style>
