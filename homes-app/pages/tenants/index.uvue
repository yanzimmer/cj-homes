<template>
  <view class="page">
    <view class="card hero-card">
      <view class="row space-between top-line">
        <view>
          <text class="section-title">租户管理</text>
          <text class="hero-sub">支持查询、详情、编辑、退房与删除</text>
        </view>
        <view class="count-chip">{{ filteredTenants.length }} 条</view>
      </view>

      <view class="row search-row">
        <input v-model="searchKeyword" class="input search-input" placeholder="姓名 / 身份证 / 手机 / 房间号" />
        <button class="btn-outline clear-btn" @click="clearSearch">清空</button>
      </view>

      <view class="row action-row">
        <button class="btn-strong" @click="openCreateTenant">新增租户</button>
        <button class="btn-outline" :disabled="loading" @click="fetchTenants">
          {{ loading ? "加载中..." : "刷新列表" }}
        </button>
      </view>
    </view>

    <view v-if="filteredTenants.length == 0" class="card empty-card">
      <text class="muted">暂无租户数据</text>
    </view>

    <view v-for="item in filteredTenants" :key="item.id_card" class="card tenant-card">
      <view class="row space-between tenant-head">
        <view>
          <text class="tenant-name">{{ item.name || "-" }}</text>
          <text class="tenant-id">身份证：{{ item.id_card || "-" }}</text>
        </view>
        <text class="gender-tag">{{ item.gender || "-" }}</text>
      </view>

      <view class="tenant-meta">
        <text class="tenant-line">手机号：{{ item.phone || "-" }}</text>
        <text class="tenant-line">房间号：{{ item.room_no || "-" }}</text>
        <text class="tenant-line">入住日期：{{ item.check_in_date || "-" }}</text>
        <text class="tenant-line">到期日期：{{ item.check_out_date || "-" }}</text>
      </view>

      <view class="row button-row">
        <button class="small-btn btn-outline" @click="openDetail(item)">详情</button>
        <button class="small-btn edit-btn" @click="openEditTenant(item)">编辑</button>
        <button class="small-btn checkout-btn" @click="checkoutTenant(item)">退房</button>
        <button class="small-btn danger-btn" @click="removeTenant(item)">删除</button>
      </view>
    </view>

    <view v-if="detailVisible" class="detail-mask" @click="closeDetail">
      <scroll-view class="detail-sheet" scroll-y="true">
        <view class="card detail-card" @click.stop>
          <view class="row space-between">
            <text class="section-title">租户详情</text>
            <button class="btn-outline" @click="closeDetail">关闭</button>
          </view>
          <view v-if="detailLoading">
            <text class="muted">加载中...</text>
          </view>
          <view v-else>
            <text class="tenant-line">姓名：{{ detailTenant.name || "-" }}</text>
            <text class="tenant-line">性别：{{ detailTenant.gender || "-" }}</text>
            <text class="tenant-line">身份证：{{ detailTenant.id_card || "-" }}</text>
            <text class="tenant-line">手机号：{{ detailTenant.phone || "-" }}</text>
            <text class="tenant-line">房间号：{{ detailTenant.room_no || "-" }}</text>
            <text class="tenant-line">入住日期：{{ detailTenant.check_in_date || "-" }}</text>
            <text class="tenant-line">到期日期：{{ detailTenant.check_out_date || "-" }}</text>
            <text class="tenant-line">状态：{{ detailTenant.status || "-" }}</text>
            <text class="detail-subtitle">关联维修记录</text>
            <view v-if="tenantRepairs.length == 0">
              <text class="muted">暂无关联维修记录</text>
            </view>
            <view v-else>
              <view v-for="record in tenantRepairs" :key="record.id" class="repair-item">
                <text class="tenant-line">#{{ record.id || "-" }} {{ record.repair_type || "-" }}</text>
                <text class="tenant-line">状态：{{ record.status || "-" }}</text>
                <text class="tenant-line">描述：{{ record.description || "-" }}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from "vue"
import { onShow } from "@dcloudio/uni-app"
import { apiCheckoutTenant, apiDeleteTenant, apiGetRepairRecordsByRoom, apiGetTenants } from "../../api/services.uts"

const tenants = ref<any[]>([])
const loading = ref(false)
const searchKeyword = ref("")
const detailVisible = ref(false)
const detailLoading = ref(false)
const detailTenant = ref<any>({})
const tenantRepairs = ref<any[]>([])

const filteredTenants = computed(() => {
  const keyword = searchKeyword.value.trim().toLowerCase()
  if (keyword == "") {
    return tenants.value
  }
  return tenants.value.filter((item) => {
    const name = item != null && item.name != null ? String(item.name).toLowerCase() : ""
    const idCard = item != null && item.id_card != null ? String(item.id_card).toLowerCase() : ""
    const phone = item != null && item.phone != null ? String(item.phone).toLowerCase() : ""
    const roomNo = item != null && item.room_no != null ? String(item.room_no).toLowerCase() : ""
    return name.includes(keyword) || idCard.includes(keyword) || phone.includes(keyword) || roomNo.includes(keyword)
  })
})

function normalizeTenants(data : any) : any[] {
  if (data != null && Array.isArray(data.tenants)) {
    return data.tenants
  }
  if (Array.isArray(data)) {
    return data
  }
  return []
}

function getErrorMessage(err : any, fallback : string) : string {
  if (err != null && err.message != null) {
    return String(err.message)
  }
  return fallback
}

async function fetchTenants() {
  if (loading.value) {
    return
  }

  loading.value = true
  try {
    const data = await apiGetTenants()
    tenants.value = normalizeTenants(data)
  } catch (err) {
    uni.showToast({
      title: getErrorMessage(err, "获取租户失败"),
      icon: "none",
    })
  } finally {
    loading.value = false
  }
}

function clearSearch() {
  searchKeyword.value = ""
}

function openCreateTenant() {
  uni.navigateTo({
    url: "/pages/tenants/form",
  })
}

function openEditTenant(tenant : any) {
  const idCard = encodeURIComponent(String(tenant.id_card))
  uni.navigateTo({
    url: `/pages/tenants/form?id_card=${idCard}`,
  })
}

async function openDetail(tenant : any) {
  detailVisible.value = true
  detailLoading.value = true
  detailTenant.value = tenant
  tenantRepairs.value = []
  try {
    const roomNo = tenant != null && tenant.room_no != null ? String(tenant.room_no).trim() : ""
    if (roomNo != "") {
      const data = await apiGetRepairRecordsByRoom(roomNo)
      if (data != null && Array.isArray(data.repair_records)) {
        tenantRepairs.value = data.repair_records
      } else if (data != null && Array.isArray(data.records)) {
        tenantRepairs.value = data.records
      } else {
        tenantRepairs.value = []
      }
    }
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "获取详情失败"), icon: "none" })
  } finally {
    detailLoading.value = false
  }
}

function closeDetail() {
  detailVisible.value = false
}

function removeTenant(tenant : any) {
  uni.showModal({
    title: "确认删除",
    content: `确定删除租户 ${tenant.name} 吗？`,
    success: async (res) => {
      if (!res.confirm) {
        return
      }
      try {
        await apiDeleteTenant(String(tenant.id_card))
        uni.showToast({ title: "删除成功", icon: "success" })
        fetchTenants()
      } catch (err) {
        uni.showToast({
          title: getErrorMessage(err, "删除失败"),
          icon: "none",
        })
      }
    },
  })
}

function checkoutTenant(tenant : any) {
  uni.showModal({
    title: "确认退房",
    content: `确认办理 ${tenant.name} 的退房吗？`,
    success: async (res) => {
      if (!res.confirm) {
        return
      }
      try {
        await apiCheckoutTenant(String(tenant.id_card))
        uni.showToast({ title: "退房成功", icon: "success" })
        fetchTenants()
      } catch (err) {
        uni.showToast({
          title: getErrorMessage(err, "退房失败"),
          icon: "none",
        })
      }
    },
  })
}

onShow(() => {
  fetchTenants()
})
</script>

<style>
.hero-card,
.empty-card,
.tenant-card {
  margin-bottom: 12px;
}

.hero-card {
  border: 1px solid rgba(12, 83, 122, 0.2);
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.96) 0%, rgba(226, 242, 251, 0.86) 58%, rgba(255, 245, 225, 0.86) 100%);
  box-shadow: 0 16px 30px rgba(16, 44, 68, 0.14);
}

.top-line {
  align-items: flex-start;
}

.hero-sub {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #5b6f82;
}

.count-chip {
  height: 30px;
  min-width: 76px;
  padding: 0 12px;
  border-radius: 999px;
  background: linear-gradient(135deg, #0b6f88 0%, #1496b7 100%);
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-row {
  margin-top: 12px;
  gap: 8px;
}

.search-input {
  flex: 1;
  height: 40px;
  padding: 0 12px;
  border-radius: 12px;
}

.clear-btn {
  flex: 0 0 auto;
  min-width: 74px;
  padding: 0 12px;
}

.action-row {
  margin-top: 10px;
  gap: 8px;
}

.action-row .btn-strong {
  flex: 1.1;
}

.action-row .btn-outline {
  flex: 0.9;
}

.tenant-card {
  border: 1px solid rgba(18, 43, 65, 0.12);
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 12px 22px rgba(18, 43, 65, 0.1);
}

.tenant-head {
  align-items: flex-start;
  margin-bottom: 8px;
}

.tenant-name {
  display: block;
  font-size: 18px;
  font-weight: 800;
  color: #10263a;
}

.tenant-id {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: #5b6f82;
}

.gender-tag {
  height: 26px;
  padding: 0 11px;
  border-radius: 999px;
  background: rgba(16, 132, 176, 0.14);
  color: #0f5470;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.tenant-meta {
  padding: 10px;
  border-radius: 12px;
  border: 1px solid rgba(18, 43, 65, 0.08);
  background: rgba(248, 252, 255, 0.9);
}

.tenant-line {
  display: block;
  margin-top: 4px;
  color: #2d4458;
  font-size: 13px;
}

.tenant-line:first-child {
  margin-top: 0;
}

.button-row {
  gap: 8px;
  margin-top: 10px;
}

.small-btn {
  flex: 1;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(13, 28, 43, 0.4);
  z-index: 1000;
  padding: 20px 16px;
  box-sizing: border-box;
}

.detail-sheet {
  height: 90vh;
  max-height: 90vh;
}

.detail-card {
  margin-top: 0;
}

.detail-subtitle {
  display: block;
  margin-top: 10px;
  font-size: 13px;
  font-weight: 700;
  color: #10263a;
}

.repair-item {
  margin-top: 8px;
  padding: 10px;
  border-radius: 10px;
  border: 1px solid rgba(18, 43, 65, 0.08);
  background: rgba(247, 252, 255, 0.92);
}

</style>
