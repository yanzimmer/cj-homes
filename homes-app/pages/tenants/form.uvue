<template>
  <view class="page">
    <view class="card form-card">
      <text class="section-title">{{ isEdit ? "编辑租户" : "新增租户" }}</text>
      <text class="muted">带 * 为必填，日期格式建议 YYYY-MM-DD</text>

      <view class="field-group">
        <view class="row space-between">
          <text class="label">身份证OCR识别</text>
          <text class="muted">{{ ocrLoading ? "识别中..." : "选正面图后自动填充" }}</text>
        </view>
        <button class="btn-outline ocr-btn" :disabled="ocrLoading" @click="runFrontOcr">
          {{ ocrLoading ? "识别中..." : "识别身份证正面" }}
        </button>
      </view>

      <view class="field-group">
        <text class="label">姓名 *</text>
        <input v-model="name" class="input" placeholder="请输入姓名" />
      </view>

      <view class="field-group">
        <text class="label">性别 *</text>
        <input v-model="gender" class="input" placeholder="男/女" />
      </view>

      <view class="field-group">
        <text class="label">身份证号 *</text>
        <input
          v-model="idCard"
          class="input"
          :disabled="isEdit"
          placeholder="请输入身份证号"
        />
      </view>

      <view class="field-group">
        <text class="label">手机号 *</text>
        <input v-model="phone" class="input" placeholder="请输入手机号" type="number" />
      </view>

      <view class="field-group">
        <text class="label">紧急联系人 *</text>
        <input
          v-model="emergencyContactName"
          class="input"
          placeholder="请输入紧急联系人"
        />
      </view>

      <view class="field-group">
        <text class="label">紧急联系人电话 *</text>
        <input
          v-model="emergencyContactPhone"
          class="input"
          placeholder="请输入紧急联系人电话"
          type="number"
        />
      </view>

      <view class="field-group">
        <text class="label">入住日期 *</text>
        <input v-model="checkInDate" class="input" placeholder="例如 2026-03-09" />
      </view>

      <view class="field-group">
        <text class="label">退租日期 *</text>
        <input v-model="checkOutDate" class="input" placeholder="例如 2026-06-30" />
      </view>

      <view class="field-group">
        <text class="label">房号 *</text>
        <input v-model="roomNo" class="input" placeholder="例如 A101" />
      </view>

      <view class="field-group">
        <text class="label">身份证地址(简)</text>
        <input v-model="idAddress" class="input" placeholder="可选简写" />
      </view>

      <view class="field-group">
        <text class="label">身份证正面图</text>
        <view class="row image-actions">
          <button class="small-btn action-btn" @click="pickFrontImage">选择图片</button>
          <button class="small-btn btn-outline" :disabled="frontPreview == ''" @click="previewImage(frontPreview)">预览</button>
          <button class="small-btn danger-btn" :disabled="frontPreview == ''" @click="clearFrontImage">清除</button>
        </view>
      </view>

      <view class="field-group">
        <text class="label">身份证反面图</text>
        <view class="row image-actions">
          <button class="small-btn action-btn" @click="pickBackImage">选择图片</button>
          <button class="small-btn btn-outline" :disabled="backPreview == ''" @click="previewImage(backPreview)">预览</button>
          <button class="small-btn danger-btn" :disabled="backPreview == ''" @click="clearBackImage">清除</button>
        </view>
      </view>

      <button class="btn-primary" :disabled="loading" @click="submitForm">
        {{ loading ? "提交中..." : "保存" }}
      </button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from "vue"
import { onLoad } from "@dcloudio/uni-app"
import { apiCreateTenant, apiGetTenants, apiOcrIdCard, apiUpdateTenant } from "../../api/services.uts"
import { getApiHost } from "../../common/request.uts"

const editingIdCard = ref("")
const loading = ref(false)

const name = ref("")
const gender = ref("")
const idCard = ref("")
const phone = ref("")
const emergencyContactName = ref("")
const emergencyContactPhone = ref("")
const checkInDate = ref("")
const checkOutDate = ref("")
const roomNo = ref("")
const idAddress = ref("")
const ocrLoading = ref(false)

const frontPreview = ref("")
const backPreview = ref("")
const frontData = ref("")
const backData = ref("")
const frontLocalPath = ref("")
const clearFrontFlag = ref(false)
const clearBackFlag = ref(false)

const isEdit = computed(() => editingIdCard.value != "")

function normalizeTenants(data : any) : any[] {
  if (data != null && Array.isArray(data.tenants)) {
    return data.tenants
  }
  if (Array.isArray(data)) {
    return data
  }
  return []
}

function getErrorMessage(err : any, fallback : string) : string {
  if (err != null && err.message != null) {
    return String(err.message)
  }
  return fallback
}

function normalizeImage(value : any) : string {
  if (value == null) {
    return ""
  }
  const text = String(value)
  if (text == "") {
    return ""
  }
  if (text.startsWith("data:") || text.startsWith("http://") || text.startsWith("https://")) {
    return text
  }
  if (text.startsWith("/")) {
    return `${getApiHost()}${text}`
  }
  return `${getApiHost()}/${text}`
}

function fillForm(data : any) {
  name.value = data != null && data.name != null ? String(data.name) : ""
  gender.value = data != null && data.gender != null ? String(data.gender) : ""
  idCard.value = data != null && data.id_card != null ? String(data.id_card) : ""
  phone.value = data != null && data.phone != null ? String(data.phone) : ""
  emergencyContactName.value = data != null && data.emergency_contact_name != null ? String(data.emergency_contact_name) : ""
  emergencyContactPhone.value = data != null && data.emergency_contact_phone != null ? String(data.emergency_contact_phone) : ""
  checkInDate.value = data != null && data.check_in_date != null ? String(data.check_in_date) : ""
  checkOutDate.value = data != null && data.check_out_date != null ? String(data.check_out_date) : ""
  roomNo.value = data != null && data.room_no != null ? String(data.room_no) : ""
  idAddress.value = data != null && data.id_address != null ? String(data.id_address) : ""

  frontPreview.value = normalizeImage(data != null ? data.front_img : "")
  backPreview.value = normalizeImage(data != null ? data.back_img : "")
  frontLocalPath.value = ""
}

async function loadTenantDetail() {
  if (editingIdCard.value == "") {
    return
  }

  try {
    const data = await apiGetTenants()
    const list = normalizeTenants(data)
    const target = list.find((item) => String(item.id_card) == editingIdCard.value)
    if (target == null) {
      uni.showToast({
        title: "未找到租户信息",
        icon: "none",
      })
      return
    }
    fillForm(target)
  } catch (err) {
    uni.showToast({
      title: getErrorMessage(err, "加载租户失败"),
      icon: "none",
    })
  }
}

function buildPayload() : any {
  const payload : any = {
    name: name.value.trim(),
    gender: gender.value.trim(),
    id_card: idCard.value.trim(),
    phone: phone.value.trim(),
    emergency_contact_name: emergencyContactName.value.trim(),
    emergency_contact_phone: emergencyContactPhone.value.trim(),
    check_in_date: checkInDate.value.trim(),
    check_out_date: checkOutDate.value.trim(),
    room_no: roomNo.value.trim(),
  }

  if (idAddress.value.trim() != "") {
    payload.id_address = idAddress.value.trim()
  }
  if (frontData.value != "") {
    payload.front_img = frontData.value
  } else if (clearFrontFlag.value) {
    payload.front_img = ""
  }
  if (backData.value != "") {
    payload.back_img = backData.value
  } else if (clearBackFlag.value) {
    payload.back_img = ""
  }

  return payload
}

function validate(payload : any) : boolean {
  const requiredFields = [
    { key: "name", message: "请输入姓名" },
    { key: "gender", message: "请输入性别" },
    { key: "id_card", message: "请输入身份证号" },
    { key: "phone", message: "请输入手机号" },
    { key: "emergency_contact_name", message: "请输入紧急联系人" },
    { key: "emergency_contact_phone", message: "请输入紧急联系人电话" },
    { key: "check_in_date", message: "请输入入住日期" },
    { key: "check_out_date", message: "请输入退租日期" },
    { key: "room_no", message: "请输入房号" },
  ]

  for (let i = 0; i < requiredFields.length; i++) {
    const item = requiredFields[i]
    if (payload[item.key] == "") {
      uni.showToast({
        title: String(item.message),
        icon: "none",
      })
      return false
    }
  }

  return true
}

function readImageAsDataUrl(path : string, callback : (data : string) => void) {
  try {
    const fs = uni.getFileSystemManager()
    fs.readFile({
      filePath: path,
      encoding: "base64",
      success: (res : any) => {
        const base64 = res.data != null ? String(res.data) : ""
        const ext = path.split(".").pop() || "png"
        const lower = ext.toLowerCase()
        const mime = lower == "jpg" || lower == "jpeg" ? "image/jpeg" : "image/png"
        callback(`data:${mime};base64,${base64}`)
      },
      fail: () => {
        callback("")
      },
    })
  } catch (err) {
    callback("")
  }
}

function pickImage(
  callback : (data : string) => void,
  previewSetter : (value : string) => void,
  pathSetter : (value : string) => void,
) {
  uni.chooseImage({
    count: 1,
    sizeType: ["compressed"],
    sourceType: ["album", "camera"],
    success: (res : any) => {
      const path = res.tempFilePaths != null && res.tempFilePaths.length > 0 ? String(res.tempFilePaths[0]) : ""
      if (path == "") {
        return
      }
      pathSetter(path)
      previewSetter(path)
      readImageAsDataUrl(path, (data) => {
        if (data == "") {
          uni.showToast({ title: "读取图片失败", icon: "none" })
          return
        }
        callback(data)
        previewSetter(data)
      })
    },
    fail: () => {
      uni.showToast({ title: "选择图片失败", icon: "none" })
    },
  })
}

function pickFrontImage() {
  clearFrontFlag.value = false
  frontLocalPath.value = ""
  pickImage(
    (data : string) => {
      frontData.value = data
    },
    (value : string) => {
      frontPreview.value = value
    },
    (value : string) => {
      frontLocalPath.value = value
    },
  )
}

function pickBackImage() {
  clearBackFlag.value = false
  pickImage(
    (data : string) => {
      backData.value = data
    },
    (value : string) => {
      backPreview.value = value
    },
    (_ : string) => {
    },
  )
}

function clearFrontImage() {
  frontPreview.value = ""
  frontData.value = ""
  frontLocalPath.value = ""
  clearFrontFlag.value = true
}

function clearBackImage() {
  backPreview.value = ""
  backData.value = ""
  clearBackFlag.value = true
}

function previewImage(url : string) {
  if (url == "") {
    return
  }
  uni.previewImage({ urls: [url] })
}

async function runFrontOcr() {
  if (ocrLoading.value) {
    return
  }
  if (frontLocalPath.value == "") {
    uni.showToast({ title: "请先选择身份证正面图", icon: "none" })
    return
  }
  ocrLoading.value = true
  try {
    const data = await apiOcrIdCard(frontLocalPath.value, "front")
    const fields = data != null && data.fields != null ? data.fields : {}
    const ocrName = fields != null && fields.name != null ? String(fields.name).trim() : ""
    const ocrIdCard = fields != null && fields.id_card != null ? String(fields.id_card).trim() : ""
    if (ocrName != "") {
      name.value = ocrName
    }
    if (!isEdit.value && ocrIdCard != "") {
      idCard.value = ocrIdCard
    }
    if (ocrName == "" && ocrIdCard == "") {
      uni.showToast({ title: "未识别到有效信息", icon: "none" })
      return
    }
    uni.showToast({ title: "OCR识别成功", icon: "success" })
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "OCR识别失败"), icon: "none" })
  } finally {
    ocrLoading.value = false
  }
}

async function submitForm() {
  if (loading.value) {
    return
  }

  const payload = buildPayload()
  if (!validate(payload)) {
    return
  }

  loading.value = true
  try {
    if (isEdit.value) {
      await apiUpdateTenant(editingIdCard.value, payload)
    } else {
      await apiCreateTenant(payload)
    }

    uni.showToast({
      title: "保存成功",
      icon: "success",
    })

    setTimeout(() => {
      uni.navigateBack()
    }, 300)
  } catch (err) {
    uni.showToast({
      title: getErrorMessage(err, "保存失败"),
      icon: "none",
    })
  } finally {
    loading.value = false
  }
}

onLoad((options : any) => {
  if (options != null && options.id_card != null) {
    editingIdCard.value = decodeURIComponent(String(options.id_card))
    loadTenantDetail()
  }
})
</script>

<style>
.form-card {
  gap: 10px;
}

.field-group {
  gap: 6px;
}

.image-actions {
  gap: 8px;
}

.ocr-btn {
  margin-top: 6px;
}

.input {
  height: 42px;
  padding: 0 12px;
  font-size: 14px;
}

.textarea {
  min-height: 84px;
  padding: 10px 12px;
  font-size: 14px;
}
</style>
