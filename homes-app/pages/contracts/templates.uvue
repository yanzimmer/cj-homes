<template>
  <view class="page">
    <view class="card hero-card">
      <view class="row space-between top-line">
        <view>
          <text class="section-title">合同管理</text>
          <text class="hero-sub">模板维护、参数渲染与级联删除</text>
        </view>
        <view class="count-chip">{{ templates.length }} 条</view>
      </view>

      <view class="row action-row">
        <button class="btn-primary" @click="openCreateTemplate">新建模板</button>
        <button class="btn-outline" @click="openCreateContract(null)">新建合同</button>
        <button class="btn-outline" :disabled="loading" @click="fetchTemplates">
          {{ loading ? "加载中..." : "刷新" }}
        </button>
      </view>
    </view>

    <view v-if="templates.length == 0" class="card empty-card">
      <text class="muted">暂无模板</text>
    </view>

    <view v-for="item in templates" :key="item.id" class="card item-card">
      <view class="row space-between item-head">
        <text class="item-title">{{ item.name || "-" }}</text>
        <text class="id-chip">#{{ item.id || "-" }}</text>
      </view>

      <view class="item-body">
        <text class="line">描述：{{ item.description || "-" }}</text>
        <text class="line">更新时间：{{ item.updated_at || item.created_at || "-" }}</text>
      </view>

      <view class="row button-row">
        <button class="small-btn btn-outline" :disabled="previewingId == item.id" @click="previewTemplate(item)">
          {{ previewingId == item.id ? "加载中..." : "预览" }}
        </button>
        <button class="small-btn danger-btn" @click="removeTemplate(item)">删除</button>
      </view>
    </view>

    <view v-if="previewVisible" class="detail-mask" @click="closePreview">
      <scroll-view class="detail-sheet" scroll-y="true">
        <view class="card detail-card" @click.stop>
          <view class="row space-between">
            <text class="section-title">模板预览</text>
            <button class="btn-outline" @click="closePreview">关闭</button>
          </view>
          <view class="preview-body">
            <rich-text :nodes="previewHtml" />
          </view>
        </view>
      </scroll-view>
    </view>

  </view>
</template>

<script setup lang="uts">
import { ref } from "vue"
import { onShow } from "@dcloudio/uni-app"
import {
  apiDeleteContractTemplate,
  apiGetContractTemplates,
  apiRenderContractTemplate,
} from "../../api/services.uts"
import { getErrorMessage, normalizeArray } from "../../common/page.uts"

const templates = ref<any[]>([])
const loading = ref(false)
const previewingId = ref(0)
const previewVisible = ref(false)
const previewHtml = ref("")

async function fetchTemplates() {
  if (loading.value) {
    return
  }

  loading.value = true
  try {
    const data = await apiGetContractTemplates()
    templates.value = normalizeArray(data, ["templates", "contract_templates", "items"])
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "获取模板失败"), icon: "none" })
  } finally {
    loading.value = false
  }
}

function openCreateContract(item : any) {
  const id = Number(item != null ? item.id : 0)
  if (!isNaN(id) && id > 0) {
    uni.navigateTo({ url: `/pages/contracts/form?template_id=${id}` })
  } else {
    uni.navigateTo({ url: "/pages/contracts/form" })
  }
}

function openCreateTemplate() {
  uni.navigateTo({ url: "/pages/contracts/template-form" })
}

async function previewTemplate(item : any) {
  const id = Number(item.id)
  if (isNaN(id) || id <= 0) {
    uni.showToast({ title: "模板ID无效", icon: "none" })
    return
  }

  previewingId.value = id
  try {
    const data = await apiRenderContractTemplate(id, {})
    const html = data != null && data.rendered_html != null
      ? String(data.rendered_html)
      : (data != null && data.html != null ? String(data.html) : "")
    if (html.trim() == "") {
      previewHtml.value = `<div style="color:#64748b;padding:8px 0;">暂无可预览内容</div>`
    } else {
      previewHtml.value = html
    }
    previewVisible.value = true
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "预览失败"), icon: "none" })
  } finally {
    previewingId.value = 0
  }
}

function closePreview() {
  previewVisible.value = false
}

function shouldUseCascade(err : any) : boolean {
  const message = getErrorMessage(err, "").toLowerCase()
  return message.includes("cascade") || message.includes("关联") || message.includes("合同") || message.includes("reference")
}

async function tryDeleteTemplate(id : number, cascade : boolean) {
  await apiDeleteContractTemplate(id, cascade)
  uni.showToast({ title: cascade ? "级联删除成功" : "删除成功", icon: "success" })
  fetchTemplates()
}

function removeTemplate(item : any) {
  const id = Number(item.id)
  if (isNaN(id) || id <= 0) {
    uni.showToast({ title: "模板ID无效", icon: "none" })
    return
  }

  uni.showModal({
    title: "确认删除",
    content: `确定删除模板 #${id} 吗？`,
    success: async (res) => {
      if (!res.confirm) {
        return
      }
      try {
        await tryDeleteTemplate(id, false)
      } catch (err) {
        if (!shouldUseCascade(err)) {
          uni.showToast({ title: getErrorMessage(err, "删除失败"), icon: "none" })
          return
        }

        uni.showModal({
          title: "存在关联合同",
          content: "该模板存在关联合同，是否执行级联删除？",
          success: async (secondRes) => {
            if (!secondRes.confirm) {
              return
            }
            try {
              await tryDeleteTemplate(id, true)
            } catch (cascadeErr) {
              uni.showToast({ title: getErrorMessage(cascadeErr, "级联删除失败"), icon: "none" })
            }
          },
        })
      }
    },
  })
}

onShow(() => {
  fetchTemplates()
})
</script>

<style>
.hero-card,
.empty-card,
.item-card {
  margin-bottom: 12px;
}

.hero-card {
  border: 1px solid rgba(11, 96, 126, 0.2);
  background:
    linear-gradient(148deg, rgba(255, 255, 255, 0.95) 0%, rgba(226, 244, 252, 0.86) 56%, rgba(255, 244, 228, 0.86) 100%);
  box-shadow: 0 16px 28px rgba(16, 44, 68, 0.14);
}

.top-line {
  align-items: flex-start;
}

.hero-sub {
  display: block;
  margin-top: 4px;
  color: #5b6f82;
  font-size: 12px;
}

.count-chip {
  min-width: 78px;
  height: 30px;
  padding: 0 12px;
  border-radius: 999px;
  background: linear-gradient(135deg, #0b6885 0%, #1490b3 100%);
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-row {
  margin-top: 12px;
  gap: 8px;
}

.action-row .btn-strong {
  flex: 1.1;
}

.action-row .btn-outline {
  flex: 0.9;
}

.item-card {
  border: 1px solid rgba(18, 43, 65, 0.12);
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 12px 22px rgba(18, 43, 65, 0.1);
}

.item-head {
  margin-bottom: 8px;
}

.item-title {
  font-size: 17px;
  color: #11293d;
  font-weight: 800;
}

.id-chip {
  height: 26px;
  padding: 0 9px;
  border-radius: 999px;
  background: rgba(17, 102, 132, 0.12);
  color: #0d516a;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.item-body {
  padding: 10px;
  border-radius: 12px;
  border: 1px solid rgba(18, 43, 65, 0.08);
  background: rgba(247, 252, 255, 0.92);
}

.line {
  display: block;
  margin-top: 4px;
  color: #2d4458;
  font-size: 13px;
}

.line:first-child {
  margin-top: 0;
}

.button-row {
  gap: 8px;
  margin-top: 10px;
}

.small-btn {
  flex: 1;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(13, 28, 43, 0.4);
  z-index: 1000;
  padding: 20px 16px;
  box-sizing: border-box;
}

.detail-sheet {
  height: 90vh;
  max-height: 90vh;
}

.detail-card {
  margin-top: 0;
  border: 1px solid rgba(18, 43, 65, 0.12);
}

.preview-body {
  margin-top: 8px;
  padding: 12px;
  border-radius: 12px;
  border: 1px solid rgba(18, 43, 65, 0.08);
  background: rgba(255, 255, 255, 0.96);
}

</style>
