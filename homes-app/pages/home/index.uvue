  <view class="page">
    <view class="card warning-card">
      <view class="row space-between warning-head">
        <view>
          <text class="section-title">到期预警</text>
          <text class="warning-sub">未来 {{ warningDays }} 天内到期租户</text>
        </view>
        <button class="btn-outline warning-btn" @click="go('/pages/tenants/index')">去处理</button>
      </view>
      <view v-if="expiringTenants.length == 0" class="warning-empty">
        <text class="muted">暂无即将到期租户</text>
      </view>
      <view v-else>
        <view v-for="item in expiringTenants" :key="item.id_card || item.name" class="warning-item">
          <view class="row space-between warning-item-top">
            <text class="warning-name">{{ item.name || "-" }}</text>
            <text class="warning-days">剩余 {{ item.left_days }} 天</text>
          </view>
          <text class="warning-line">房间: {{ item.room_no || "-" }} | 电话: {{ item.phone || "-" }}</text>
          <text class="warning-line">到期日期：{{ item.check_out_date || "-" }}</text>
        </view>
      </view>
    </view>

    <view class="card overview-card">
      <view class="row space-between overview-head">
        <view>
          <text class="section-title">今日概览</text>
          <text class="overview-sub">实时统计来自房间与租户接口</text>
        </view>
        <button class="btn-outline refresh-btn" :disabled="loadingStats" @click="refreshStats">
          {{ loadingStats ? "刷新中..." : "刷新" }}
        </button>
      </view>

      <view class="overview-grid">
        <view class="row overview-row">
          <view class="overview-item">
            <view class="stat-tile palette-room">
              <text class="stat-label">房间总数</text>
              <text class="stat-value">{{ roomCount }}</text>
              <text class="stat-hint">全量房源</text>
            </view>
          </view>
          <view class="overview-item">
            <view class="stat-tile palette-tenant">
              <text class="stat-label">租户总数</text>
              <text class="stat-value">{{ tenantCount }}</text>
              <text class="stat-hint">当前在册</text>
            </view>
          </view>
          <view class="overview-item">
            <view class="stat-tile palette-free">
              <text class="stat-label">空闲</text>
              <text class="stat-value">{{ statusFree }}</text>
              <text class="stat-hint">可出租</text>
            </view>
          </view>
        </view>

        <view class="row overview-row">
          <view class="overview-item">
            <view class="stat-tile palette-live">
              <text class="stat-label">在住</text>
              <text class="stat-value">{{ statusLive }}</text>
              <text class="stat-hint">稳定入住</text>
            </view>
          </view>
          <view class="overview-item">
            <view class="stat-tile palette-soon">
              <text class="stat-label">即将到期</text>
              <text class="stat-value">{{ statusSoon }}</text>
              <text class="stat-hint">需跟进</text>
            </view>
          </view>
          <view class="overview-item">
            <view class="stat-tile palette-expired">
              <text class="stat-label">已过期</text>
              <text class="stat-value">{{ statusExpired }}</text>
              <text class="stat-hint">待处理</text>
            </view>
          </view>
        </view>

        <view class="row overview-row">
          <view class="overview-item">
            <view class="stat-tile palette-repair-pending">
              <text class="stat-label">维修待处理</text>
              <text class="stat-value">{{ repairPending }}</text>
              <text class="stat-hint">需派单</text>
            </view>
          </view>
          <view class="overview-item">
            <view class="stat-tile palette-repair-working">
              <text class="stat-label">维修处理中</text>
              <text class="stat-value">{{ repairWorking }}</text>
              <text class="stat-hint">进行中</text>
            </view>
          </view>
          <view class="overview-item">
            <view class="stat-tile palette-repair-done">
              <text class="stat-label">维修已完成</text>
              <text class="stat-value">{{ repairDone }}</text>
              <text class="stat-hint">可回访</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="card modules-card">
      <view class="row space-between">
        <text class="section-title">业务模块</text>
        <text class="muted">10 项</text>
      </view>

      <view class="modules-grid layout-3">
        <view class="module-item" @click="go('/pages/rooms/index')">
          <view class="module-tile m1">
            <view class="module-icon">房</view>
            <text class="module-name">房间管理</text>
            <text class="module-desc">房态与价格</text>
          </view>
        </view>
        <view class="module-item" @click="go('/pages/tenants/index')">
          <view class="module-tile m2">
            <view class="module-icon">租</view>
