          </view>
        </view>
        <view class="module-item" @click="go('/pages/repairs/index')">
          <view class="module-tile m4">
            <view class="module-icon">修</view>
            <text class="module-name">维修记录</text>
            <text class="module-desc">工单处理</text>
          </view>
        </view>
        <view class="module-item" @click="go('/pages/procurements/index')">
          <view class="module-tile m5">
            <view class="module-icon">采</view>
            <text class="module-name">采购管理</text>
            <text class="module-desc">采购清单</text>
          </view>
        </view>
        <view class="module-item" @click="go('/pages/warehouse/index')">
          <view class="module-tile m6">
            <view class="module-icon">库</view>
            <text class="module-name">库房管理</text>
            <text class="module-desc">库存物资</text>
          </view>
        </view>
        <view class="module-item" @click="go('/pages/contracts/templates')">
          <view class="module-tile m7">
            <view class="module-icon">合</view>
            <text class="module-name">合同管理</text>
            <text class="module-desc">模板维护</text>
          </view>
        </view>
        <view class="module-item" @click="go('/pages/notification/index')">
          <view class="module-tile m9">
            <view class="module-icon">通</view>
            <text class="module-name">通知配置</text>
            <text class="module-desc">短信邮件</text>
          </view>
        </view>
        <view class="module-item" @click="go('/pages/system/index')">
          <view class="module-tile m11">
            <view class="module-icon">系</view>
            <text class="module-name">系统工具</text>
            <text class="module-desc">导入导出</text>
          </view>
        </view>
        <view class="module-item" @click="go('/pages/account/security')">
          <view class="module-tile m12">
            <view class="module-icon">安</view>
            <text class="module-name">账号安全</text>
            <text class="module-desc">密码管理</text>
          </view>
        </view>
      </view>
    </view>

    <button class="btn-danger logout-btn" @click="logout">退出登录</button>
  </view>
</template>

<script setup lang="uts">
import { ref } from "vue"
import { onShow } from "@dcloudio/uni-app"
import { apiGetRepairRecords, apiGetRooms, apiGetTenants, apiVerifyToken } from "../../api/services.uts"
import {
  clearLoginInfo,
  isLoggedIn,
} from "../../common/session.uts"

const roomCount = ref(0)
const tenantCount = ref(0)
const statusFree = ref(0)
const statusLive = ref(0)
const statusSoon = ref(0)
const statusExpired = ref(0)
const repairPending = ref(0)
const repairWorking = ref(0)
const repairDone = ref(0)
const warningDays = ref(30)
const expiringTenants = ref<any[]>([])
const loadingStats = ref(false)

function goLogin() {
  uni.reLaunch({
    url: "/pages/login/index",
  })
}

function go(path : string) {
  uni.navigateTo({ url: path })
}

function normalizeList(data : any, key : string) : any[] {
  if (data != null && Array.isArray(data[key])) {
    return data[key]
  }
  if (Array.isArray(data)) {
    return data
  }
  return []
}

function updateStatusCounts(rooms : any[]) {
  let free = 0
  let live = 0
  let soon = 0
  let expired = 0

  rooms.forEach((room) => {
    const status = room != null && room.status != null ? String(room.status) : ""
    if (status == "空闲") {
      free += 1
      return
    }
    if (status == "\u5728\u4f4f" || status == "\u5df2\u5165\u4f4f" || status.toLowerCase() == "live") {
      live += 1
      return
    }
    if (status == "即将到期") {
      soon += 1
      return
    }
    if (status == "\u5df2\u8fc7\u671f" || status.toLowerCase() == "expired") {
      expired += 1
    }
  })

  statusFree.value = free
  statusLive.value = live
  statusSoon.value = soon
  statusExpired.value = expired
}

function normalizeDateText(value : any) : string {
  if (value == null) return ""
  return String(value).trim()
}

function parseDate(value : any) : number {
  const text = normalizeDateText(value)
  if (text == "") return 0
  const ts = Date.parse(text.replace(/-/g, "/"))
  if (isNaN(ts)) return 0
  return ts
}

function calcLeftDays(checkOutDate : any) : number {
  const end = parseDate(checkOutDate)
  if (end <= 0) return -1
  const now = new Date()
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
  const diff = end - today
  return Math.floor(diff / 86400000)
}

function updateRepairCounts(list : any[]) {
  let pending = 0
  let working = 0
  let done = 0
  list.forEach((item) => {
    const status = item != null && item.status != null ? String(item.status) : ""
    if (status == "\u5f85\u5904\u7406" || status.toLowerCase() == "pending") {
      pending += 1
      return
    }
    if (status == "\u5904\u7406\u4e2d" || status.toLowerCase() == "working") {
      working += 1
      return
    }
    if (status == "\u5df2\u5b8c\u6210" || status.toLowerCase() == "done") {
      done += 1
    }
  })
  repairPending.value = pending
  repairWorking.value = working
  repairDone.value = done
}

function updateExpiringTenants(list : any[]) {
  const result : any[] = []
  list.forEach((item) => {
    const status = item != null && item.status != null ? String(item.status) : ""
    if (status == "\u5df2\u9000\u79df" || status.toLowerCase() == "checked_out") return
    const leftDays = calcLeftDays(item != null ? item.check_out_date : "")
    if (leftDays < 0 || leftDays > warningDays.value) return
    result.push({
      ...item,
      left_days: leftDays,
    })
  })
  result.sort((a, b) => Number(a.left_days || 0) - Number(b.left_days || 0))
  expiringTenants.value = result.slice(0, 6)
}

async function verifyLogin() {
  if (!isLoggedIn()) {
    goLogin()
    return false
  }

  try {
    await apiVerifyToken()
    return true
  } catch (err) {
    clearLoginInfo()
    uni.showToast({
      title: "登录状态已失效，请重新登录",
      icon: "none",
    })
    goLogin()
    return false
  }
}

async function refreshStats() {
  if (loadingStats.value) {
    return
  }

  loadingStats.value = true
  try {
    const roomData = await apiGetRooms()
    const tenantData = await apiGetTenants()
    const repairData = await apiGetRepairRecords()
    const rooms = normalizeList(roomData, "rooms")
    const tenants = normalizeList(tenantData, "tenants")
    const repairs = normalizeList(repairData, "repair_records")
    roomCount.value = rooms.length
    updateStatusCounts(rooms)
    tenantCount.value = tenants.length
    updateRepairCounts(repairs)
    updateExpiringTenants(tenants)
  } catch (err : any) {
    uni.showToast({
      title: err != null && err.message != null ? String(err.message) : "获取统计失败",
      icon: "none",
    })
  } finally {
    loadingStats.value = false
  }
}

function logout() {
  uni.showModal({
    title: "提示",
    content: "确认退出登录吗？",
    success: (res) => {
      if (!res.confirm) {
        return
      }
      clearLoginInfo()
      goLogin()
    },
  })
}

onShow(async () => {
  const ok = await verifyLogin()
  if (ok) {
    refreshStats()
  }
})
</script>

