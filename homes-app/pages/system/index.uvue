      <view class="row button-row">
        <button class="btn-primary action-btn" :disabled="exportLoading" @click="exportData">
          {{ exportLoading ? "导出中..." : "导出数据" }}
        </button>
        <button class="action-btn" @click="pickImportFile">选择ZIP</button>
      </view>

      <view class="field-group">
        <text class="label">导入文件路径</text>
        <input v-model="importFilePath" class="input" placeholder="未选择文件时可手动输入路径" />
      </view>

      <button class="action-btn" :disabled="importLoading" @click="importData">
        {{ importLoading ? "导入中..." : "导入数据" }}
      </button>

      <text v-if="exportPath != ''" class="muted">导出文件：{{ exportPath }}</text>
    </view>

    <view class="card section">
      <text class="section-title">演示与重置</text>
      <view class="row button-row">
        <button class="action-btn seed-btn" :disabled="seedLoading" @click="seedData">
          {{ seedLoading ? "生成中..." : "生成演示数据" }}
        </button>
        <button class="action-btn danger-btn" :disabled="resetLoading" @click="resetData">
          {{ resetLoading ? "重置中..." : "重置系统" }}
        </button>
      </view>
      <view class="field-group reset-confirm-group">
        <text class="label">重置确认码</text>
        <input v-model="resetConfirmText" class="input" placeholder="请输入 RESET 后才能执行重置" />
      </view>
