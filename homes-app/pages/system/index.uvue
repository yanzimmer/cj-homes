    <view class="card section">
      <view class="row space-between">
        <text class="section-title">API接口总览</text>
        <text class="muted">用于APP对接</text>
      </view>
      <textarea :value="apiOverviewText" class="textarea" disabled />
      <button class="action-btn" @click="copyOverview">复制接口文档</button>
