  align-items: flex-start;
  gap: 8px;
}

.top-line > view:first-child {
  flex: 1;
  min-width: 0;
}

.hero-sub {
  display: block;
  margin-top: 4px;
  color: #5b6f82;
  font-size: 12px;
}

.count-chip {
  min-width: 72px;
  height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  background: linear-gradient(135deg, #0b6885 0%, #1490b3 100%);
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
}

.action-row {
  margin-top: 10px;
  gap: 8px;
}

.action-row .btn-strong {
  flex: 1.1;
}

.action-row .btn-outline {
  flex: 0.9;
}

.filter-card {
  border: 1px solid rgba(18, 43, 65, 0.1);
  background: rgba(255, 255, 255, 0.93);
}

.filter-label {
  display: block;
  color: #5b6f82;
  font-size: 12px;
}

.filter-row {
  margin-top: 8px;
  gap: 6px;
  align-items: center;
}

.input {
  flex: 0 0 34%;
  min-width: 96px;
  height: 40px;
  padding: 0 12px;
}

.search-btn {
  flex: 0 0 auto;
  width: 64px;
  height: 36px;
  padding: 0;
  border-radius: 10px;
  font-size: 13px;
}

.reset-btn {
  flex: 0 0 auto;
  width: 64px;
  height: 36px;
  padding: 0;
  border-radius: 10px;
  font-size: 13px;
}

.filter-row .input {
  height: 36px;
  margin-top: 0;
}

.record-card {
  border: 1px solid rgba(18, 43, 65, 0.12);
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 12px 22px rgba(18, 43, 65, 0.1);
}

.record-head {
  margin-bottom: 8px;
}

.record-title {
  font-size: 17px;
  font-weight: 800;
  color: #11293d;
}

.record-type {
  height: 26px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(29, 78, 216, 0.14);
  color: #1e3a8a;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.record-body {
  padding: 10px;
  border-radius: 12px;
  background: rgba(247, 252, 255, 0.92);
  border: 1px solid rgba(18, 43, 65, 0.08);
}

.line {
  display: block;
  margin-top: 4px;
  color: #2d4458;
  font-size: 13px;
}

.line:first-child {
  margin-top: 0;
}

.repair-image-row {
  margin-top: 6px;
  gap: 6px;
}

.repair-thumb {
  width: 72px;
  height: 72px;
  border-radius: 8px;
  background: #f3f4f6;
}

.button-row {
  gap: 8px;
  margin-top: 10px;
}

.small-btn {
  flex: 1;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(13, 28, 43, 0.4);
  z-index: 1000;
  padding: 20px 16px;
  box-sizing: border-box;
}

.detail-sheet {
  height: 90vh;
  max-height: 90vh;
}

.detail-card {
  margin-top: 0;
  border: 1px solid rgba(18, 43, 65, 0.12);
}

.detail-empty {
  margin-top: 8px;
}

.detail-body {
  margin-top: 6px;
  padding: 10px;
  border-radius: 12px;
  border: 1px solid rgba(18, 43, 65, 0.08);
  background: rgba(247, 252, 255, 0.92);
}

</style>
