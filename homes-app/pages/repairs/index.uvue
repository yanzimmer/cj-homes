<template>
  <view class="page">
    <view class="card hero-card">
      <view class="row space-between top-line">
        <view>
          <text class="section-title">维修记录</text>
          <text class="hero-sub">支持查询、详情、编辑和删除维修记录</text>
        </view>
        <view class="count-chip">{{ records.length }} 条</view>
      </view>

      <view class="row action-row">
        <button class="btn-strong" @click="openCreate">新增记录</button>
        <button class="btn-outline" :disabled="loading" @click="fetchRecords">
          {{ loading ? "加载中..." : "刷新列表" }}
        </button>
      </view>
    </view>

    <view class="card filter-card">
      <text class="filter-label">按房间号查询</text>
      <view class="row filter-row">
        <input v-model="roomFilter" class="input" placeholder="请输入房间号，例如 A101" />
        <button class="search-btn" :disabled="loading" @click="queryByRoom">查询</button>
        <button class="btn-outline reset-btn" @click="resetFilter">重置</button>
      </view>
    </view>

    <view v-if="records.length == 0" class="card empty-card">
      <text class="muted">暂无维修记录</text>
    </view>

    <view v-for="item in records" :key="item.id" class="card record-card">
      <view class="row space-between record-head">
        <text class="record-title">#{{ item.id || "-" }} {{ item.room_no || "-" }}</text>
        <text class="record-type">{{ item.repair_type || "-" }}</text>
      </view>

      <view class="record-body">
        <text class="line">楼栋：{{ item.building || "-" }}</text>
        <text class="line">房间号：{{ item.room_no || "-" }}</text>
        <text class="line">维修类型：{{ item.repair_type || "-" }}</text>
        <text class="line">维修人员：{{ item.report_by || "-" }}</text>
        <text class="line">问题描述：{{ item.description || "-" }}</text>
        <text class="line">维修时间：{{ item.report_date || "-" }}</text>
        <text class="line">维修日期：{{ item.repair_date || "-" }}</text>
        <text class="line">维修费用：{{ item.repair_cost != null && String(item.repair_cost) != "" ? "¥" + item.repair_cost : "-" }}</text>
        <text class="line">维修人员：{{ item.repair_person || "-" }}</text>
        <text class="line">备注：{{ item.remarks || "-" }}</text>
        <view v-if="extractRepairImages(item).length > 0" class="repair-image-row">
          <text class="line">图片预览：</text>
          <image class="repair-thumb" :src="normalizeImage(extractRepairImages(item)[0])" mode="aspectFill" @click="openImages(extractRepairImages(item), 0)" />
        </view>
        <text class="line">状态：{{ item.status || "-" }}</text>
      </view>

      <view class="row button-row">
        <button class="small-btn btn-outline" @click="openDetail(item)">详情</button>
        <button class="small-btn edit-btn" @click="openEdit(item)">编辑</button>
        <button class="small-btn danger-btn" @click="removeRecord(item)">删除</button>
      </view>
    </view>

    <view v-if="detailVisible" class="detail-mask" @click="closeDetail">
      <scroll-view class="detail-sheet" scroll-y="true">
        <view class="card detail-card" @click.stop>
          <view class="row space-between">
            <text class="section-title">维修详情</text>
            <button class="btn-outline" @click="closeDetail">关闭</button>
          </view>

          <view v-if="detailLoading" class="detail-empty">
            <text class="muted">加载中...</text>
          </view>

          <view v-else class="detail-body">
            <text class="line">记录ID：{{ detailRecord.id || "-" }}</text>
            <text class="line">楼栋：{{ detailRecord.building || "-" }}</text>
            <text class="line">房间号：{{ detailRecord.room_no || "-" }}</text>
            <text class="line">维修类型：{{ detailRecord.repair_type || "-" }}</text>
            <text class="line">维修人员：{{ detailRecord.report_by || "-" }}</text>
            <text class="line">维修时间：{{ detailRecord.report_date || "-" }}</text>
            <text class="line">状态：{{ detailRecord.status || "-" }}</text>
            <text class="line">问题描述：{{ detailRecord.description || "-" }}</text>
            <text class="line">维修日期：{{ detailRecord.repair_date || "-" }}</text>
            <text class="line">维修费用：{{ detailRecord.repair_cost != null && String(detailRecord.repair_cost) != "" ? "¥" + detailRecord.repair_cost : "-" }}</text>
            <text class="line">维修人员：{{ detailRecord.repair_person || "-" }}</text>
            <text class="line">备注：{{ detailRecord.remarks || "-" }}</text>
            <view v-if="extractRepairImages(detailRecord).length > 0" class="repair-image-row">
              <text class="line">维修图片：</text>
              <image class="repair-thumb" :src="normalizeImage(extractRepairImages(detailRecord)[0])" mode="aspectFill" @click="openImages(extractRepairImages(detailRecord), 0)" />
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from "vue"
import { onShow } from "@dcloudio/uni-app"
import {
  apiDeleteRepairRecord,
  apiGetRepairRecordDetail,
  apiGetRepairRecords,
  apiGetRepairRecordsByRoom,
} from "../../api/services.uts"
import { getErrorMessage, normalizeArray } from "../../common/page.uts"
import { getApiHost } from "../../common/request.uts"

const records = ref<any[]>([])
const loading = ref(false)
const roomFilter = ref("")

const detailVisible = ref(false)
const detailLoading = ref(false)
const detailRecord = ref<any>({})

function normalizeImage(value : any) : string {
  if (value == null) return ""
  const text = String(value)
  if (text == "") return ""
  if (
    text.startsWith("data:")
    || text.startsWith("http://")
    || text.startsWith("https://")
    || text.startsWith("file://")
    || text.startsWith("content://")
    || text.startsWith("wxfile://")
    || text.startsWith("blob:")
    || text.startsWith("_doc/")
    || text.startsWith("_www/")
    || text.startsWith("\\")
    || text.includes(":\\")
  ) {
    return text
  }
  if (text.startsWith("/static/")) {
    return `${getApiHost()}${text}`
  }
  if (text.startsWith("/")) {
    return text
  }
  return `${getApiHost()}/${text}`
}

function extractRepairImages(item : any) : string[] {
  if (item != null && Array.isArray(item.repair_images)) {
    return item.repair_images.map((v : any) => String(v)).filter((v : string) => v.trim() != "")
  }
  const raw = item != null && item.repair_image != null ? String(item.repair_image) : ""
  if (raw.trim() == "") return []
  if (raw.trim().startsWith("[")) {
    try {
      const arr = JSON.parse(raw)
      if (Array.isArray(arr)) {
        return arr.map((v : any) => String(v)).filter((v : string) => v.trim() != "")
      }
    } catch (e) {
    }
  }
  return [raw]
}

function openImages(values : string[], index : number = 0) {
  if (values.length == 0) return
  const urls = values.map((v : string) => normalizeImage(v)).filter((v : string) => v != "")
  if (urls.length == 0) return
  const current = index >= 0 && index < urls.length ? urls[index] : urls[0]
  uni.previewImage({ urls, current })
}

async function fetchRecords() {
  if (loading.value) {
    return
  }

  loading.value = true
  try {
    const data = await apiGetRepairRecords()
    records.value = normalizeArray(data, ["repair_records", "records"])
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "获取维修记录失败"), icon: "none" })
  } finally {
    loading.value = false
  }
}

async function queryByRoom() {
  const roomNo = roomFilter.value.trim()
  if (roomNo == "") {
    fetchRecords()
    return
  }
  loading.value = true
  try {
    const data = await apiGetRepairRecordsByRoom(roomNo)
    records.value = normalizeArray(data, ["repair_records", "records"])
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "查询失败"), icon: "none" })
  } finally {
    loading.value = false
  }
}

function resetFilter() {
  roomFilter.value = ""
  fetchRecords()
}

function openCreate() {
  uni.navigateTo({ url: "/pages/repairs/form" })
}

function openEdit(item : any) {
  uni.navigateTo({ url: `/pages/repairs/form?id=${item.id}` })
}

async function openDetail(item : any) {
  const id = Number(item.id)
  if (isNaN(id) || id <= 0) {
    uni.showToast({ title: "记录ID无效", icon: "none" })
    return
  }

  detailVisible.value = true
  detailLoading.value = true
  detailRecord.value = item

  try {
    const data = await apiGetRepairRecordDetail(id)
    detailRecord.value = data != null && data.repair_record != null ? data.repair_record : (data != null ? data : item)
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "获取详情失败"), icon: "none" })
  } finally {
    detailLoading.value = false
  }
}

function closeDetail() {
  detailVisible.value = false
}

function removeRecord(item : any) {
  const id = Number(item.id)
  if (isNaN(id) || id <= 0) {
    uni.showToast({ title: "记录ID无效", icon: "none" })
    return
  }

  uni.showModal({
    title: "确认删除",
    content: `确定删除维修记录 #${id} 吗？`,
    success: async (res) => {
      if (!res.confirm) {
        return
      }
      try {
        await apiDeleteRepairRecord(id)
        uni.showToast({ title: "删除成功", icon: "success" })
        fetchRecords()
      } catch (err) {
        uni.showToast({ title: getErrorMessage(err, "删除失败"), icon: "none" })
      }
    },
  })
}

onShow(() => {
  fetchRecords()
})
</script>

<style>
.hero-card,
.filter-card,
.empty-card,
.record-card {
  margin-bottom: 12px;
}

.hero-card {
  border: 1px solid rgba(11, 96, 126, 0.2);
  background:
    linear-gradient(148deg, rgba(255, 255, 255, 0.95) 0%, rgba(226, 244, 252, 0.86) 56%, rgba(255, 244, 228, 0.86) 100%);
  box-shadow: 0 16px 28px rgba(16, 44, 68, 0.14);
}

