<template>
  <view class="page">
    <view class="back-wrap">
      <button class="btn-outline back-btn" @click="goBack">{{ "< " + backLabel }}</button>
    </view>
    <view class="card section">
      <view class="row space-between">
        <text class="section-title">通知配置</text>
        <text class="muted">/api/notification-config</text>
      </view>

      <view class="field-group">
        <text class="label">配置(JSON)</text>
        <textarea v-model="configText" class="textarea" placeholder='{"smtp":{},"sms":{}}' />
      </view>

      <view class="row button-row">
        <button class="btn-primary action-btn" :disabled="loading" @click="fetchConfig">
          {{ loading ? "加载中..." : "加载配置" }}
        </button>
        <button class="action-btn save-btn" :disabled="loading" @click="saveConfig">
          保存配置
        </button>
      </view>
    </view>

    <view class="card section">
      <text class="section-title">测试邮件</text>
      <text class="muted">/api/test-email</text>

      <view class="field-group">
        <text class="label">SMTP配置(JSON)</text>
        <textarea v-model="emailConfigText" class="textarea" placeholder='{"host":"smtp.example.com","port":465,"username":"xxx","password":"xxx"}' />
      </view>

      <view class="field-group">
        <text class="label">收件人</text>
        <input v-model="emailRecipient" class="input" placeholder="name@example.com" />
      </view>

      <view class="field-group">
        <text class="label">发件人</text>
        <input v-model="emailSender" class="input" placeholder="no-reply@example.com" />
      </view>

      <view class="field-group">
        <text class="label">标题</text>
        <input v-model="emailSubject" class="input" placeholder="测试邮件" />
      </view>

      <view class="field-group">
        <text class="label">内容</text>
        <textarea v-model="emailContent" class="textarea" placeholder="请输入邮件内容" />
      </view>

      <view class="row switch-row">
        <text class="label">使用SSL</text>
        <switch :checked="emailUseSSL" @change="onEmailSSLChange" />
      </view>

      <button class="action-btn" :disabled="emailLoading" @click="sendTestEmail">
        {{ emailLoading ? "发送中..." : "发送测试邮件" }}
      </button>
    </view>

    <view class="card section">
      <text class="section-title">测试短信</text>
      <text class="muted">/api/test-sms</text>

      <view class="field-group">
        <text class="label">短信配置(JSON)</text>
        <textarea v-model="smsConfigText" class="textarea" placeholder='{"access_key":"xxx","secret":"xxx"}' />
      </view>

      <view class="field-group">
        <text class="label">模板ID</text>
        <input v-model="smsTemplateId" class="input" placeholder="模板ID" />
      </view>

      <view class="field-group">
        <text class="label">模板参数(JSON)</text>
        <textarea v-model="smsTemplateParamsText" class="textarea" placeholder='{"code":"123456"}' />
      </view>

      <button class="action-btn" :disabled="smsLoading" @click="sendTestSms">
        {{ smsLoading ? "发送中..." : "发送测试短信" }}
      </button>
    </view>

    <view class="card section">
      <text class="section-title">发送通知</text>
      <text class="muted">/api/notify/send</text>

      <view class="field-group">
        <text class="label">通知请求(JSON)</text>
        <textarea v-model="notifyPayloadText" class="textarea" placeholder='{"title":"系统通知","content":"测试消息","channels":["email"]}' />
      </view>

      <button class="action-btn" :disabled="notifyLoading" @click="sendNotify">
        {{ notifyLoading ? "发送中..." : "发送通知" }}
      </button>
    </view>

    <view class="card section">
      <view class="row space-between">
        <text class="section-title">发送历史</text>
        <button class="history-btn" :disabled="historyLoading" @click="fetchNotifyHistory">
          {{ historyLoading ? "加载中..." : "查询" }}
        </button>
      </view>
      <text class="muted">/api/notify/history?days=</text>

      <view class="field-group">
        <text class="label">查询天数</text>
        <input v-model="historyDays" class="input" type="number" placeholder="7" />
      </view>

      <view v-if="historyLoading" class="history-empty">
        <text class="muted">加载中...</text>
      </view>
      <view v-else-if="notifyHistory.length == 0" class="history-empty">
        <text class="muted">暂无发送记录</text>
      </view>
      <view v-else>
        <view v-for="(item, idx) in notifyHistory" :key="item.id || item.record_id || idx" class="history-item">
          <text class="history-line">时间：{{ item.created_at || item.send_time || item.time || "-" }}</text>
          <text class="history-line">渠道：{{ item.channel || item.channels || "-" }}</text>
          <text class="history-line">状态：{{ item.status || "-" }}</text>
          <text class="history-line">标题：{{ item.title || item.subject || "-" }}</text>
          <text class="history-line">内容：{{ item.content || item.message || "-" }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from "vue"
import { onShow } from "@dcloudio/uni-app"
import {
  apiGetNotificationConfig,
  apiGetNotifyHistory,
  apiNotifySend,
  apiTestEmail,
  apiTestSms,
  apiUpdateNotificationConfig,
} from "../../api/services.uts"
import { getErrorMessage, normalizeArray, parseJsonText, prettyJson } from "../../common/page.uts"

const backLabel = "\u8fd4\u56de"

const configText = ref("{}")
const loading = ref(false)

const emailConfigText = ref("{}")
const emailRecipient = ref("")
const emailSender = ref("")
const emailSubject = ref("测试邮件")
const emailContent = ref("这是一封测试邮件")
const emailUseSSL = ref(true)
const emailLoading = ref(false)

const smsConfigText = ref("{}")
const smsTemplateId = ref("")
const smsTemplateParamsText = ref("{}")
const smsLoading = ref(false)

const notifyPayloadText = ref('{"title":"系统通知","content":"测试消息","channels":["email"]}')
const notifyLoading = ref(false)

const historyDays = ref("7")
const historyLoading = ref(false)
const notifyHistory = ref<any[]>([])

async function fetchConfig() {
  if (loading.value) {
    return
  }
  loading.value = true
  try {
    const data = await apiGetNotificationConfig()
    configText.value = prettyJson(data)
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "获取配置失败"), icon: "none" })
  } finally {
    loading.value = false
  }
}

async function saveConfig() {
  if (loading.value) {
    return
  }

  let payload : any = {}
  try {
    payload = parseJsonText(configText.value)
  } catch (err) {
    uni.showToast({ title: "配置JSON格式错误", icon: "none" })
    return
  }

  loading.value = true
  try {
    await apiUpdateNotificationConfig(payload)
    uni.showToast({ title: "保存成功", icon: "success" })
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "保存失败"), icon: "none" })
  } finally {
    loading.value = false
  }
}

function onEmailSSLChange(e : any) {
  emailUseSSL.value = e != null && e.detail != null ? Boolean(e.detail.value) : false
}

async function sendTestEmail() {
  if (emailLoading.value) {
    return
  }

  if (emailRecipient.value.trim() == "") {
    uni.showToast({ title: "请输入收件人", icon: "none" })
    return
  }

  let smtpConfig : any = {}
  try {
    smtpConfig = parseJsonText(emailConfigText.value)
  } catch (err) {
    uni.showToast({ title: "SMTP配置JSON格式错误", icon: "none" })
    return
  }

  emailLoading.value = true
  try {
    await apiTestEmail({
      smtp_config: smtpConfig,
      recipient: emailRecipient.value.trim(),
      sender: emailSender.value.trim(),
      subject: emailSubject.value.trim(),
      content: emailContent.value.trim(),
      use_ssl: emailUseSSL.value,
    })
    uni.showToast({ title: "发送成功", icon: "success" })
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "发送失败"), icon: "none" })
  } finally {
    emailLoading.value = false
  }
}

async function sendTestSms() {
  if (smsLoading.value) {
    return
  }

  if (smsTemplateId.value.trim() == "") {
    uni.showToast({ title: "请输入模板ID", icon: "none" })
    return
  }

  let smsConfig : any = {}
  let templateParams : any = {}
  try {
    smsConfig = parseJsonText(smsConfigText.value)
  } catch (err) {
    uni.showToast({ title: "短信配置JSON格式错误", icon: "none" })
    return
  }
  try {
    templateParams = parseJsonText(smsTemplateParamsText.value)
  } catch (err) {
    uni.showToast({ title: "模板参数JSON格式错误", icon: "none" })
    return
  }

  smsLoading.value = true
  try {
    await apiTestSms({
      sms_config: smsConfig,
      template_id: smsTemplateId.value.trim(),
      template_params: templateParams,
    })
    uni.showToast({ title: "发送成功", icon: "success" })
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "发送失败"), icon: "none" })
  } finally {
    smsLoading.value = false
  }
}

function getHistoryDays() : number {
  const value = Number(historyDays.value)
  if (isNaN(value) || value <= 0) {
    return 7
  }
  return Math.floor(value)
}

async function sendNotify() {
  if (notifyLoading.value) {
    return
  }

  let payload : any = {}
  try {
    payload = parseJsonText(notifyPayloadText.value)
  } catch (err) {
    uni.showToast({ title: "通知请求JSON格式错误", icon: "none" })
    return
  }

  notifyLoading.value = true
  try {
    await apiNotifySend(payload)
    uni.showToast({ title: "发送成功", icon: "success" })
    fetchNotifyHistory()
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "发送失败"), icon: "none" })
  } finally {
    notifyLoading.value = false
  }
}

async function fetchNotifyHistory() {
  if (historyLoading.value) {
    return
  }

  historyLoading.value = true
  try {
    const data = await apiGetNotifyHistory(getHistoryDays())
    notifyHistory.value = normalizeArray(data, ["history", "items", "list", "records"])
  } catch (err) {
    uni.showToast({ title: getErrorMessage(err, "查询历史失败"), icon: "none" })
  } finally {
    historyLoading.value = false
  }
}

function goBack() {
  const pages = getCurrentPages()
  if (pages != null && pages.length > 1) {
    uni.navigateBack({ delta: 1 })
    return
  }
  uni.reLaunch({ url: "/pages/home/index" })
}

onShow(() => {
  fetchNotifyHistory()
})
</script>

<style>
.section {
  margin-bottom: 12px;
  border: 1px solid rgba(18, 43, 65, 0.12);
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 12px 22px rgba(18, 43, 65, 0.1);
}

.section:first-child {
  border: 1px solid rgba(11, 96, 126, 0.2);
  background:
    linear-gradient(148deg, rgba(255, 255, 255, 0.95) 0%, rgba(226, 244, 252, 0.86) 56%, rgba(255, 244, 228, 0.86) 100%);
  box-shadow: 0 16px 28px rgba(16, 44, 68, 0.14);
}

.field-group {
  gap: 6px;
  margin-top: 8px;
}

.label {
  font-size: 13px;
  color: #1f3347;
  font-weight: 600;
}

.input {
  height: 40px;
  padding: 0 12px;
  border-radius: 12px;
}

.textarea {
  min-height: 100px;
  padding: 10px;
  box-sizing: border-box;
  border-radius: 12px;
}

.button-row {
  margin-top: 10px;
  gap: 8px;
}

.action-btn {
  flex: 1;
}

.save-btn {
  flex: 1;
}

.history-btn {
  width: 96px;
  border-radius: 12px;
}

.switch-row {
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}

.history-empty {
  margin-top: 8px;
}

.history-item {
  margin-top: 8px;
  border-radius: 12px;
  padding: 10px;
  background: rgba(247, 252, 255, 0.92);
  border: 1px solid rgba(18, 43, 65, 0.08);
}

.history-line {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: #2d4458;
}

.back-wrap {
  margin-bottom: 10px;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.back-btn {
  flex: 0 0 auto;
  width: auto !important;
  min-width: 88px;
  height: 34px;
  padding: 0 14px !important;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}


</style>
