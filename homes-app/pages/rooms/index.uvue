  flex: 1;
}

.btn-outline {
  flex: 0.78;
}

.search-card {
  margin-top: 12px;
  padding: 12px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(20, 38, 56, 0.1);
}

.search-label {
  font-size: 12px;
  color: #607285;
  margin-bottom: 7px;
  display: block;
}

.search-row {
  gap: 8px;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 40px;
  padding: 0 12px;
  border-radius: 12px;
}

.count-pill {
  min-width: 74px;
  height: 40px;
  padding: 0 12px;
  border-radius: 999px;
  background: linear-gradient(135deg, rgba(10, 111, 116, 0.18), rgba(17, 163, 178, 0.22));
  color: #0a6f74;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.filter-bar {
  margin-top: 10px;
  gap: 8px;
  align-items: center;
  padding: 10px;
  border-radius: 14px;
  background: rgba(248, 252, 253, 0.84);
  border: 1px solid rgba(20, 38, 56, 0.1);
}

.filter-bar .btn-outline {
  flex: 0 0 auto;
  min-width: 92px;
  padding: 0 14px;
}

.summary-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.summary-chip {
  padding: 4px 9px;
  border-radius: 999px;
  background: rgba(224, 243, 246, 0.9);
  color: #345468;
  font-size: 11px;
  border: 1px solid rgba(52, 84, 104, 0.12);
}

.room-card {
  border: 1px solid rgba(20, 38, 56, 0.1);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12px 24px rgba(20, 38, 56, 0.09);
}

.room-head {
  margin-bottom: 8px;
}

.room-title {
  gap: 7px;
}

.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.room-no {
  font-size: 20px;
  color: #102435;
  font-weight: 800;
}

.room-meta {
  margin-top: 5px;
}

.room-line {
  display: block;
  margin-top: 4px;
  color: #2d4458;
  font-size: 13px;
}

.status-pill {
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.qr-row {
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 9px;
}

.qr-chip {
  flex: 1;
  min-width: 140px;
  background: #f8fbfd;
  border-radius: 11px;
  padding: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
  border: 1px solid rgba(20, 38, 56, 0.08);
}

.qr-label {
  font-size: 12px;
  color: #5d6c7b;
}

