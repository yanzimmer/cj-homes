  height: 28px;
  padding: 0 9px;
  border-radius: 8px;
  font-size: 11px;
}

.button-row {
  margin-top: 10px;
  gap: 8px;
}

.small-btn {
  flex: 1;
  border-radius: 10px;
  font-size: 12px;
}

.pager-card {
  margin-top: 10px;
  margin-bottom: 14px;
}

.pager-row {
  gap: 10px;
}

.pager-btn {
  flex: 0 0 auto;
  min-width: 88px;
}

.pager-text {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: #4f6479;
}

.status-free {
  background-color: #ddf7e6;
  color: #17633a;
}

.status-live {
  background-color: #e0eeff;
  color: #1e4d9f;
}

.status-soon {
  background-color: #fff1d7;
  color: #8c5304;
}

.status-expired {
  background-color: #ffe5e5;
  color: #9f2a2a;
}

.status-unknown {
  background-color: #edf1f5;
  color: #4b5563;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(13, 28, 43, 0.4);
  z-index: 1000;
  padding: 20px 16px;
  box-sizing: border-box;
}

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(13, 28, 43, 0.4);
  z-index: 1000;
  padding: 0 12px 12px;
  box-sizing: border-box;
  display: flex;
  align-items: flex-end;
}

.detail-sheet {
  height: 90vh;
  max-height: 90vh;
}

.detail-card {
  margin-top: 0;
