.room-card {
  margin-bottom: 14px;
}

.toolbar-card {
  border: 1px solid rgba(10, 111, 116, 0.2);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94) 0%, rgba(227, 246, 248, 0.86) 56%, rgba(255, 244, 223, 0.86) 100%);
  box-shadow: 0 18px 34px rgba(13, 41, 59, 0.12);
}

