import { request, uploadFile, API_PREFIX, getApiHost, handleUnauthorized } from "../common/request.uts"
import { getToken } from "../common/session.uts"

// Auth
export function apiLogin(username : string, password : string) {
  return request({
    path: "/login",
    method: "POST",
    auth: false,
    data: {
      username,
      password,
    },
  })
}

export function apiForgotPassword(username : string, answer : string, newPassword : string) {
  return request({
    path: "/forgot-password",
    method: "POST",
    auth: false,
    data: {
      username,
      answer,
      new_password: newPassword,
    },
  })
}

export function apiVerifyToken() {
  return request({
    path: "/verify-token",
    method: "GET",
  })
}

export function apiChangePassword(oldPassword : string, newPassword : string) {
  return request({
    path: "/change-password",
    method: "POST",
    data: {
      old_password: oldPassword,
      new_password: newPassword,
    },
  })
}

// OCR
export function apiOcrIdCard(filePath : string, side : string = "front") {
  return uploadFile({
    path: "/ocr/idcard",
    filePath,
    name: "image",
    formData: {
      side,
    },
  })
}

