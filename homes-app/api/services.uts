// System
export function apiSeedSystemData() {
  return request({ path: "/system/seed", method: "POST" })
}

export function apiResetSystemData() {
  return request({ path: "/system/reset", method: "POST" })
}

export function apiImportSystemData(filePath : string) {
  return uploadFile({
    path: "/system/import",
    filePath,
    name: "file",
  })
}

export function apiExportSystemData() : Promise<any> {
  const token = getToken()
  const header : any = {}
  if (token != "") {
    header["Authorization"] = `Bearer ${token}`
  }

  return new Promise((resolve, reject) => {
    uni.downloadFile({
      url: `${getApiHost()}${API_PREFIX}/system/export`,
      header,
      success: (res : any) => {
        const statusCode = Number(res.statusCode)
        if (statusCode >= 200 && statusCode < 300) {
          resolve({
            tempFilePath: res.tempFilePath,
            statusCode,
          })
          return
        }
        if (statusCode == 401) {
          handleUnauthorized()
        }
        reject({
          statusCode,
          message: statusCode == 401 ? "登录已失效，请重新登录" : "导出失败",
          data: res,
        })
      },
      fail: (err : any) => {
        reject({
          statusCode: 0,
          message: err != null && err.errMsg != null ? String(err.errMsg) : "导出失败",
          data: err,
        })
      },
    })
  })
}

