import { clearLoginInfo, getToken, setToken, setTokenExpires } from "./session.uts"

const API_HOST_KEY = "housing_api_host"
const DEFAULT_API_HOST = "http://127.0.0.1:5000"
let unauthorizedRedirecting = false

export const API_HOST = DEFAULT_API_HOST
export const API_PREFIX = "/api"

function normalizeHost(host : string) : string {
  let value = host.trim()
  while (value.endsWith("/")) {
    value = value.slice(0, value.length - 1)
  }
  return value
}

export function getApiHost() : string {
  const host = uni.getStorageSync(API_HOST_KEY)
  if (host == null) {
    return DEFAULT_API_HOST
  }
  const value = normalizeHost(String(host))
  return value == "" ? DEFAULT_API_HOST : value
}

export function setApiHost(host : string) {
  const value = normalizeHost(host)
  if (value == "") {
    uni.removeStorageSync(API_HOST_KEY)
    return
  }
  uni.setStorageSync(API_HOST_KEY, value)
}

export function resetApiHost() {
  uni.removeStorageSync(API_HOST_KEY)
}

export function getApiBaseUrl() : string {
  return `${getApiHost()}${API_PREFIX}`
}

export function handleUnauthorized() {
  if (unauthorizedRedirecting) {
    return
  }
  unauthorizedRedirecting = true

  clearLoginInfo()
  uni.showToast({
    title: "登录已失效，请重新登录",
    icon: "none",
  })
  uni.reLaunch({
    url: "/pages/login/index",
  })

  setTimeout(() => {
    unauthorizedRedirecting = false
  }, 800)
}

function normalizePath(path : string) : string {
  const apiHost = getApiHost()
  if (path.startsWith("http://") || path.startsWith("https://")) {
    return path
  }
  if (path.startsWith(API_PREFIX)) {
    return `${apiHost}${path}`
  }
  if (path.startsWith("/")) {
    return `${apiHost}${API_PREFIX}${path}`
  }
  return `${apiHost}${API_PREFIX}/${path}`
}

function buildQuery(params : any) : string {
  if (params == null) {
    return ""
  }
  const keys = Object.keys(params)
  if (keys.length == 0) {
    return ""
  }
  const result : string[] = []
  keys.forEach((key) => {
    const value = params[key]
    if (value == null || value === "") {
      return
    }
    const encodedKey = encodeURIComponent(String(key))
    const encodedValue = encodeURIComponent(String(value))
    result.push(`${encodedKey}=${encodedValue}`)
  })
  if (result.length == 0) {
    return ""
  }
  return `?${result.join("&")}`
}

function getHeaderValue(headers : any, key : string) : string {
  if (headers == null) {
    return ""
  }

  if (headers[key] != null) {
    return String(headers[key])
  }

  const lowerKey = key.toLowerCase()
  const names = Object.keys(headers)
  for (let i = 0; i < names.length; i++) {
    const name = names[i]
    if (String(name).toLowerCase() == lowerKey) {
      return String(headers[name])
    }
  }
  return ""
}

function toErrorMessage(data : any, fallback : string) : string {
  if (data == null) {
    return fallback
  }
  if (data.error != null && String(data.error) != "") {
    return String(data.error)
  }
  if (data.message != null && String(data.message) != "") {
    return String(data.message)
  }
  return fallback
}

export function request(options : any) : Promise<any> {
  const method = options != null && options.method != null ? String(options.method).toUpperCase() : "GET"
  const auth = options == null || options.auth !== false
  const headers : any = {}
  headers["Content-Type"] = options != null && options.contentType != null ? String(options.contentType) : "application/json"

  if (auth) {
    const token = getToken()
    if (token != "") {
      headers["Authorization"] = `Bearer ${token}`
    }
  }

  if (options != null && options.headers != null) {
    const customHeaderNames = Object.keys(options.headers)
    customHeaderNames.forEach((name) => {
      headers[name] = options.headers[name]
    })
  }

  const queryString = (method == "GET" || method == "DELETE") ? buildQuery(options != null ? options.query : null) : ""
  const url = `${normalizePath(options.path)}${queryString}`

  return new Promise((resolve, reject) => {
    uni.request({
      url,
      method,
      data: options != null ? options.data : null,
      header: headers,
      success: (res : any) => {
        const refreshedToken = getHeaderValue(res.header, "X-Refreshed-Token")
        const tokenExpires = getHeaderValue(res.header, "X-Token-Expires")

        if (refreshedToken != "") {
          setToken(refreshedToken)
        }
        if (tokenExpires != "") {
          setTokenExpires(tokenExpires)
        }

        const statusCode = Number(res.statusCode)
        if (statusCode >= 200 && statusCode < 300) {
          resolve(res.data)
          return
        }

        if (statusCode == 401 && auth) {
          handleUnauthorized()
        }

        reject({
          statusCode,
          message: statusCode == 401 && auth ? "登录已失效，请重新登录" : toErrorMessage(res.data, "请求失败"),
          data: res.data,
        })
      },
      fail: (err : any) => {
        reject({
          statusCode: 0,
          message: err != null && err.errMsg != null ? String(err.errMsg) : "网络错误",
          data: err,
        })
      },
    })
    if (options != null && options.onProgress != null) {
      task.onProgressUpdate((res : any) => {
        options.onProgress(res)
      })
    }
  })
}

export function uploadFile(options : any) : Promise<any> {
  const auth = options == null || options.auth !== false
  const headers : any = {}
  if (auth) {
    const token = getToken()
    if (token != "") {
      headers["Authorization"] = `Bearer ${token}`
    }
  }
  if (options != null && options.headers != null) {
    const customHeaderNames = Object.keys(options.headers)
    customHeaderNames.forEach((name) => {
      headers[name] = options.headers[name]
    })
  }

  return new Promise((resolve, reject) => {
    const task = uni.uploadFile({
      url: normalizePath(options.path),
      filePath: String(options.filePath),
      name: options.name != null ? String(options.name) : "file",
      formData: options.formData != null ? options.formData : {},
      header: headers,
      success: (res : any) => {
        let data : any = res.data
        if (typeof data === "string") {
          try {
            data = JSON.parse(data)
          } catch (e) {
            data = { raw: res.data }
          }
        }

        const statusCode = Number(res.statusCode)
        if (statusCode >= 200 && statusCode < 300) {
          resolve(data)
          return
        }

        if (statusCode == 401 && auth) {
          handleUnauthorized()
        }

        reject({
          statusCode,
          message: statusCode == 401 && auth ? "登录已失效，请重新登录" : toErrorMessage(data, "上传失败"),
          data,
        })
      },
      fail: (err : any) => {
        reject({
          statusCode: 0,
          message: err != null && err.errMsg != null ? String(err.errMsg) : "上传失败",
          data: err,
        })
      },
    })
  })
}



