export function getErrorMessage(err : any, fallback : string) : string {
  if (err == null) {
    return fallback
  }
  if (err.message != null && String(err.message) != "") {
    return String(err.message)
  }
  if (err.error != null && String(err.error) != "") {
    return String(err.error)
  }
  return fallback
}

export function normalizeArray(data : any, keys : string[] = []) : any[] {
  if (Array.isArray(data)) {
    return data
  }
  if (data == null) {
    return []
  }
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    if (Array.isArray(data[key])) {
      return data[key]
    }
  }
  if (Array.isArray(data.items)) {
    return data.items
  }
  if (Array.isArray(data.data)) {
    return data.data
  }
  if (Array.isArray(data.rows)) {
    return data.rows
  }
  return []
}

export function prettyJson(data : any) : string {
  try {
    return JSON.stringify(data, null, 2)
  } catch (e) {
    return "{}"
  }
}

export function parseJsonText(text : string) : any {
  const value = text.trim()
  if (value == "") {
    return {}
  }
  return JSON.parse(value)
}

export function toNumber(text : string, defaultValue : number = 0) : number {
  const value = Number(text)
  if (isNaN(value)) {
    return defaultValue
  }
  return value
}
