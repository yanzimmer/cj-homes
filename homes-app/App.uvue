<script lang="uts">
// #ifdef APP-ANDROID || APP-HARMONY
let firstBackTime = 0
// #endif

export default {
  onLaunch() {
    console.log("Housing App Launch")
  },
  // #ifdef APP-ANDROID || APP-HARMONY
  onLastPageBackPress() {
    if (firstBackTime == 0) {
      uni.showToast({
        title: "再按一次退出应用",
        position: "bottom",
      })
      firstBackTime = Date.now()
      setTimeout(() => {
        firstBackTime = 0
      }, 2000)
      return
    }
    if (Date.now() - firstBackTime < 2000) {
      firstBackTime = Date.now()
      uni.exit()
    }
  },
  // #endif
}
</script>

